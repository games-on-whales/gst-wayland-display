#version 450
// RGBA -> P010 (10-bit 4:2:0, BT.2020 NON-CONSTANT-LUMINANCE, limited "TV" range).
//
// Same topology as rgba_to_p010.comp (one invocation per 2x2 chroma block, 16-bit r16/rg16
// storage images, value lands in the MSBs so the P010 reader's top 10 bits are correct) --
// the ONLY difference is the RGB->YCbCr matrix uses the BT.2020 luma coefficients
// (Kr=0.2627, Kg=0.6780, Kb=0.0593) instead of BT.601's.
//
// This shader is selected when the producer signals HDR (BT.2100 PQ) output: the bitstream
// is tagged matrix=bt2020, so the luma/chroma must be derived with the BT.2020 matrix or the
// decoded colours are subtly wrong. The compositor content is 8-bit sRGB-ish and we do NOT
// tone-map to PQ here -- this is the correct *matrix* for the signalled container, the
// transfer/primaries signalling is done on the caps (see waylandsrc imp.rs / vulkanh265enc).
//
// Limited-range coefficients (R,G,B in [0,1] -> normalized YCbCr in [0,1]):
//   Y  = 16/255  + (219/255) * (Kr*R + Kg*G + Kb*B)
//   Cb = 128/255 + (224/255) * (B - Y') / (2*(1-Kb))
//   Cr = 128/255 + (224/255) * (R - Y') / (2*(1-Kr))   with Y' = Kr*R + Kg*G + Kb*B
// expanded to the constants below.
//
// Bindings:
//   0: src     - RGBA input (sampled, imported from the compositor's dmabuf)
//   1: yPlane  - r16  storage image, full resolution (P010 plane 0, 10 bits in the MSBs)
//   2: uvPlane - rg16 storage image, half resolution (P010 plane 1, Cb in r, Cr in g)
// Push constant: full-resolution size in pixels.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r16)  uniform writeonly image2D yPlane;
layout(binding = 2, rg16) uniform writeonly image2D uvPlane;

layout(push_constant) uniform Push { ivec2 size; } pc;

float luma(vec3 c) { return 0.2256 * c.r + 0.5823 * c.g + 0.0509 * c.b + 0.0627; }

void main() {
    ivec2 ch = ivec2(gl_GlobalInvocationID.xy);   // chroma coord (0..W/2, 0..H/2)
    ivec2 p  = ch * 2;                            // top-left luma coord
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;

    vec3 c00 = texelFetch(src, p + ivec2(0, 0), 0).rgb;
    vec3 c10 = texelFetch(src, p + ivec2(1, 0), 0).rgb;
    vec3 c01 = texelFetch(src, p + ivec2(0, 1), 0).rgb;
    vec3 c11 = texelFetch(src, p + ivec2(1, 1), 0).rgb;

    imageStore(yPlane, p + ivec2(0, 0), vec4(luma(c00)));
    imageStore(yPlane, p + ivec2(1, 0), vec4(luma(c10)));
    imageStore(yPlane, p + ivec2(0, 1), vec4(luma(c01)));
    imageStore(yPlane, p + ivec2(1, 1), vec4(luma(c11)));

    vec3 a = (c00 + c10 + c01 + c11) * 0.25;       // 4:2:0 average
    float cb = -0.1227 * a.r - 0.3166 * a.g + 0.4392 * a.b + 0.5;
    float cr =  0.4392 * a.r - 0.4039 * a.g - 0.0353 * a.b + 0.5;
    imageStore(uvPlane, ch, vec4(cb, cr, 0.0, 0.0));
}
