+__device__ inline float
+pq_oetf (cudaTextureObject_t pq_transfer_texture, float value)
+{
+  const float size = 1024.0f;
+  float coordinate = sqrtf (clamp (value, 0.0f, 1.0f));
+  float texel = (coordinate * (size - 1.0f) + 0.5f) / size;
+  return tex2D<float> (pq_transfer_texture, texel, 0.5f);
+}
+
+__device__ inline float3
+linear_bt709_to_bt2100_pq (float3 sample,
+    cudaTextureObject_t pq_transfer_texture)
+{
+  /* CU_TRSF_SRGB already decoded the sampled RGB into linear light. */
+  float3 bt2020 = make_float3 (
+      0.6274040f * sample.x + 0.3292820f * sample.y + 0.0433136f * sample.z,
+      0.0690970f * sample.x + 0.9195400f * sample.y + 0.0113612f * sample.z,
+      0.0163916f * sample.x + 0.0880132f * sample.y + 0.8955950f * sample.z);
+
+  /* BT.2408 graphics white: SDR 1.0 is 203 nits in a 10,000-nit PQ code space. */
+  return make_float3 (pq_oetf (pq_transfer_texture, bt2020.x),
+      pq_oetf (pq_transfer_texture, bt2020.y),
+      pq_oetf (pq_transfer_texture, bt2020.z));
+}
