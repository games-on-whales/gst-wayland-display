+static gboolean
+gst_cuda_converter_upload_pq_transfer_texture (GstCudaConverter * self)
+{
+  auto priv = self->priv;
+  std::array < float, PQ_TRANSFER_LUT_SIZE > pq_lut;
+  CUDA_RESOURCE_DESC resource_desc = { };
+  CUDA_TEXTURE_DESC texture_desc = { };
+
+  if (priv->pq_transfer_texture)
+    return TRUE;
+
+  for (size_t i = 0; i < pq_lut.size (); i++) {
+    float coordinate = (float) i / (pq_lut.size () - 1);
+    pq_lut[i] = pq_oetf_reference (BT2408_GRAPHICS_WHITE * coordinate *
+        coordinate);
+  }
+
+  if (!gst_cuda_result (CuMemAllocPitch (&priv->pq_transfer_lut,
+              &priv->pq_transfer_lut_pitch, sizeof (pq_lut), 1,
+              sizeof (float)))) {
+    GST_ERROR_OBJECT (self, "Could not allocate the PQ transfer LUT");
+    return FALSE;
+  }
+
+  if (!gst_cuda_result (CuMemcpyHtoD (priv->pq_transfer_lut,
+              pq_lut.data (), sizeof (pq_lut)))) {
+    GST_ERROR_OBJECT (self, "Could not upload the PQ transfer LUT");
+    CuMemFree (priv->pq_transfer_lut);
+    priv->pq_transfer_lut = 0;
+    return FALSE;
+  }
+
+  resource_desc.resType = CU_RESOURCE_TYPE_PITCH2D;
+  resource_desc.res.pitch2D.format = CU_AD_FORMAT_FLOAT;
+  resource_desc.res.pitch2D.numChannels = 1;
+  resource_desc.res.pitch2D.width = pq_lut.size ();
+  resource_desc.res.pitch2D.height = 1;
+  resource_desc.res.pitch2D.pitchInBytes = priv->pq_transfer_lut_pitch;
+  resource_desc.res.pitch2D.devPtr = priv->pq_transfer_lut;
+
+  texture_desc.filterMode = CU_TR_FILTER_MODE_LINEAR;
+  texture_desc.flags = CU_TRSF_NORMALIZED_COORDINATES;
+  texture_desc.addressMode[0] = CU_TR_ADDRESS_MODE_CLAMP;
+  texture_desc.addressMode[1] = CU_TR_ADDRESS_MODE_CLAMP;
+
+  if (!gst_cuda_result (CuTexObjectCreate (&priv->pq_transfer_texture,
+              &resource_desc, &texture_desc, nullptr))) {
+    GST_ERROR_OBJECT (self, "Could not create the PQ transfer texture");
+    CuMemFree (priv->pq_transfer_lut);
+    priv->pq_transfer_lut = 0;
+    return FALSE;
+  }
+
+  GST_INFO_OBJECT (self, "Uploaded hardware-interpolated PQ transfer texture");
+  return TRUE;
