+/* 7.4.3.1 Video parameter set RBSP semantics */
+static void
+gst_h265_encoder_vps_init (GstH265Encoder * self)
+{
+  GstH265EncoderPrivate *priv = _GET_PRIV (self);
+  guint8 level_idc, max_dpb_minus1;
+
+  GST_DEBUG_OBJECT (self, "filling VPS");
+
+  level_idc = priv->stream.level_idc;
+  /* B8: a P picture references one picture, so the DPB needs two slots. */
+  max_dpb_minus1 = priv->gop.max_dec_frame_buffering > 1 ?
+      priv->gop.max_dec_frame_buffering - 1 : 1;
+
+  priv->params.vps = (GstH265VPS) {
+    /* *INDENT-OFF* */
+    .id = 0,
+    .base_layer_internal_flag = 1,
+    .base_layer_available_flag = 1,
+    .max_layers_minus1 = 0,
+    .max_sub_layers_minus1 = 0,
+    .temporal_id_nesting_flag = 1,
+
+    .profile_tier_level = {
+      .profile_space = 0,
+      .tier_flag = priv->stream.tier,
+      .profile_idc = priv->stream.profile,
+      .progressive_source_flag = 1,
+      .interlaced_source_flag = 0,
+      .non_packed_constraint_flag = 0,
+      .frame_only_constraint_flag = 1,
+      .level_idc = level_idc,
+    },
+
+    .sub_layer_ordering_info_present_flag = 0,
+    .max_dec_pic_buffering_minus1 = { max_dpb_minus1, },
+    .max_num_reorder_pics = { priv->gop.num_reorder_frames, },
+    .max_latency_increase_plus1 = { 0, },
+
+    .max_layer_id = 0,
+    .num_layer_sets_minus1 = 0,
+    .timing_info_present_flag = 0,
+    .num_hrd_parameters = 0,
+    .vps_extension = 0,
+    /* *INDENT-ON* */
+  };
+
+  priv->params.vps.profile_tier_level.profile_compatibility_flag
+      [priv->stream.profile & 31] = 1;
+}
+
+/* 7.4.3.2.1 General sequence parameter set RBSP semantics */
+static void
+gst_h265_encoder_sps_init (GstH265Encoder * self)
+{
+  GstH265EncoderPrivate *priv = _GET_PRIV (self);
+  GstVideoInfo *info;
+  guint i;
+  guint8 chroma_format_idc, bit_depth_luma, bit_depth_chroma;
+  guint8 aspect_ratio_present_flag, aspect_ratio_idc;
+  guint16 sar_width, sar_height;
+  guint8 timing_info_present_flag;
+  guint32 num_units_in_tick, time_scale;
+  guint8 conformance_window_flag, level_idc;
+  guint16 width, height, luma_width, luma_height;
+  guint32 conf_win_right_offset, conf_win_bottom_offset;
+  guint8 max_dpb_minus1;
+  /* MinCbSizeY = 8 (log2 == 3), CtbSizeY = 64 (log2 == 6). */
+  const guint8 log2_min_cb_minus3 = 0;
+  const guint8 log2_diff_max_min_cb = 3;
+
+  info = &priv->input_state->info;
+
+  GST_DEBUG_OBJECT (self, "filling SPS");
+
+  chroma_format_idc = _h265_get_chroma_idc (info);
+  bit_depth_luma = GST_VIDEO_INFO_COMP_DEPTH (info, 0);
+  bit_depth_chroma = GST_VIDEO_INFO_COMP_DEPTH (info, 1);
+
+  width = GST_VIDEO_INFO_WIDTH (info);
+  height = GST_VIDEO_INFO_HEIGHT (info);
+
+  /* pic_width/height_in_luma_samples must be an integer multiple of
+   * MinCbSizeY (8); the remainder is cropped via the conformance window. */
+  luma_width = GST_ROUND_UP_8 (width);
+  luma_height = GST_ROUND_UP_8 (height);
+  if (luma_width != width || luma_height != height) {
+    /* Table 6-1 SubWidthC / SubHeightC */
+    const guint SubWidthC[] = { 1, 2, 2, 1 };
+    const guint SubHeightC[] = { 1, 2, 1, 1 };
+
+    conformance_window_flag = 1;
+    conf_win_right_offset = (luma_width - width) / SubWidthC[chroma_format_idc];
+    conf_win_bottom_offset =
+        (luma_height - height) / SubHeightC[chroma_format_idc];
+  } else {
+    conformance_window_flag = 0;
+    conf_win_right_offset = conf_win_bottom_offset = 0;
+  }
+
+  aspect_ratio_present_flag = aspect_ratio_idc = 0;
+  sar_width = sar_height = 0;
+  if (GST_VIDEO_INFO_PAR_N (info) != 0 && GST_VIDEO_INFO_PAR_D (info) != 0) {
+    aspect_ratio_present_flag = 1;
+    for (i = 0; i < G_N_ELEMENTS (_h265_aspect_ratio); i++) {
+      if (gst_util_fraction_compare (GST_VIDEO_INFO_PAR_N (info),
+              GST_VIDEO_INFO_PAR_D (info), _h265_aspect_ratio[i].num,
+              _h265_aspect_ratio[i].den) == 0) {
+        aspect_ratio_idc = i;
+        sar_width = sar_height = 0;
+        break;
+      }
+    }
+
+    /* Extended SAR */
+    if (i >= G_N_ELEMENTS (_h265_aspect_ratio)) {
+      aspect_ratio_idc = 0xff;
+      sar_width = GST_VIDEO_INFO_PAR_N (info);
+      sar_height = GST_VIDEO_INFO_PAR_D (info);
+    }
+  }
+
+  if (GST_VIDEO_INFO_FPS_N (info) > 0 && GST_VIDEO_INFO_FPS_D (info) > 0) {
+    timing_info_present_flag = 1;
+    num_units_in_tick = GST_VIDEO_INFO_FPS_D (info);
+    time_scale = GST_VIDEO_INFO_FPS_N (info);
+  } else {
+    timing_info_present_flag = num_units_in_tick = time_scale = 0;
+  }
+
+  level_idc = priv->stream.level_idc;
+
+  /* B8: a P picture references one picture, so the DPB needs two slots. */
+  max_dpb_minus1 = priv->gop.max_dec_frame_buffering > 1 ?
+      priv->gop.max_dec_frame_buffering - 1 : 1;
+
+  priv->params.sps = (GstH265SPS) {
+    /* *INDENT-OFF* */
+    .id = 0,
+    .vps_id = 0,
+    .max_sub_layers_minus1 = 0,
+    .temporal_id_nesting_flag = 1,
+
+    .profile_tier_level = {
+      .profile_space = 0,
+      .tier_flag = priv->stream.tier,
+      .profile_idc = priv->stream.profile,
+      .progressive_source_flag = 1,
+      .interlaced_source_flag = 0,
+      .non_packed_constraint_flag = 0,
+      .frame_only_constraint_flag = 1,
+      .level_idc = level_idc,
+    },
+
+    .chroma_format_idc = chroma_format_idc,
+    .separate_colour_plane_flag = 0,
+    .pic_width_in_luma_samples = luma_width,
+    .pic_height_in_luma_samples = luma_height,
+
+    .conformance_window_flag = conformance_window_flag,
+    .conf_win_left_offset = 0,
+    .conf_win_right_offset = conf_win_right_offset,
+    .conf_win_top_offset = 0,
+    .conf_win_bottom_offset = conf_win_bottom_offset,
+
+    .bit_depth_luma_minus8 = CLAMP (bit_depth_luma - 8, 0, 6),
+    .bit_depth_chroma_minus8 = CLAMP (bit_depth_chroma - 8, 0, 6),
+    .log2_max_pic_order_cnt_lsb_minus4 =
+        CLAMP ((gint) (priv->gop.log2_max_poc_lsb - 4), 0, 12),
+
+    .sub_layer_ordering_info_present_flag = 0,
+    .max_dec_pic_buffering_minus1 = { max_dpb_minus1, },
+    .max_num_reorder_pics = { priv->gop.num_reorder_frames, },
+    .max_latency_increase_plus1 = { 0, },
+
+    .log2_min_luma_coding_block_size_minus3 = log2_min_cb_minus3,
+    .log2_diff_max_min_luma_coding_block_size = log2_diff_max_min_cb,
+    .log2_min_transform_block_size_minus2 = 0,    /* 4x4 */
+    .log2_diff_max_min_transform_block_size = 3,  /* up to 32x32 */
+    .max_transform_hierarchy_depth_inter = 3,
+    .max_transform_hierarchy_depth_intra = 3,
+
+    .scaling_list_enabled_flag = 0,
+    .scaling_list_data_present_flag = 0,
+
+    /* Coding tools must match exactly what the Vulkan H.265 encoder emits
+     * (values per the upstream MR #5739 encoder): AMP off, SAO on, temporal
+     * MVP on, strong intra smoothing on. */
+    .amp_enabled_flag = 0,
+    .sample_adaptive_offset_enabled_flag = 1,
+    .pcm_enabled_flag = 0,
+
+    /* Short-term reference picture sets are signalled per-slice (B8). */
+    .num_short_term_ref_pic_sets = 0,
+    .long_term_ref_pics_present_flag = 0,
+
+    .temporal_mvp_enabled_flag = 1,
+    .strong_intra_smoothing_enabled_flag = 1,
+
+    .vui_parameters_present_flag = 1,
+    .vui_params = {
+      .aspect_ratio_info_present_flag = aspect_ratio_present_flag,
+      .aspect_ratio_idc = aspect_ratio_idc,
+      /* if aspect_ratio_idc == 255 (Extended_SAR) */
+      .sar_width = sar_width,
+      .sar_height = sar_height,
+
+      .overscan_info_present_flag = 0,
+      .video_signal_type_present_flag = 0,
+      .chroma_loc_info_present_flag = 0,
+      .neutral_chroma_indication_flag = 0,
+      .field_seq_flag = 0,
+      .frame_field_info_present_flag = 0,
+      .default_display_window_flag = 0,
+
+      .timing_info_present_flag = timing_info_present_flag,
+      .num_units_in_tick = num_units_in_tick,
+      .time_scale = time_scale,
+      .poc_proportional_to_timing_flag = 0,
+
+      /* We do not write HRD; no buffering period SEI is needed. */
+      .hrd_parameters_present_flag = 0,
+
+      .bitstream_restriction_flag = 1,
+      .tiles_fixed_structure_flag = 0,
+      .motion_vectors_over_pic_boundaries_flag = 1,
+      .restricted_ref_pic_lists_flag = 0,
+      .min_spatial_segmentation_idc = 0,
+      .max_bytes_per_pic_denom = 0,
+      .max_bits_per_min_cu_denom = 0,
+      .log2_max_mv_length_horizontal = 15,
+      .log2_max_mv_length_vertical = 15,
+    },
+    /* *INDENT-ON* */
+  };
+
+  /* general_profile_compatibility_flag[ profile_idc ] shall be 1. */
+  priv->params.sps.profile_tier_level.profile_compatibility_flag
+      [priv->stream.profile & 31] = 1;
+}
+
+/* 7.4.3.3.1 General picture parameter set RBSP semantics */
+static void
+gst_h265_encoder_pps_init (GstH265Encoder * self)
+{
+  GstH265EncoderPrivate *priv = _GET_PRIV (self);
+
+  /* *INDENT-OFF* */
+  priv->params.pps = (GstH265PPS) {
+    .id = 0,
+    .sps_id = 0,
+
+    .dependent_slice_segments_enabled_flag = 0,
+    .output_flag_present_flag = 0,
+    .num_extra_slice_header_bits = 0,
+    .sign_data_hiding_enabled_flag = 0,
+    .cabac_init_present_flag = 0,
+
+    /* Reference counts are driven from the slice header. */
+    .num_ref_idx_l0_default_active_minus1 = 0,
+    .num_ref_idx_l1_default_active_minus1 = 0,
+
+    .init_qp_minus26 = 0,   /* QP supplied by rate control */
+    .constrained_intra_pred_flag = 0,
+    /* The Vulkan encoder emits transform-skip syntax (RADV stdSyntaxFlags). */
+    .transform_skip_enabled_flag = 1,
+    /* RADV needs cu_qp_delta enabled to signal its internal per-CU QP, or
+     * reconstruction is wrong (washed colours). It codes the delta at depth 0
+     * (radv_video_enc.c sets diff_cu_qp_delta_depth = 0); signalling depth 1
+     * (as upstream MR #5739 does) desyncs the decoder and yields out-of-range
+     * cu_qp_delta values on varying content. */
+    .cu_qp_delta_enabled_flag = 1,
+    .diff_cu_qp_delta_depth = 0,
+    .cb_qp_offset = 0,
+    .cr_qp_offset = 0,
+    .slice_chroma_qp_offsets_present_flag = 0,
+
+    .weighted_pred_flag = 0,
+    .weighted_bipred_flag = 0,
+    .transquant_bypass_enabled_flag = 0,
+
+    /* Single slice per picture: no tiles, no WPP (B9). */
+    .tiles_enabled_flag = 0,
+    .entropy_coding_sync_enabled_flag = 0,
+
+    .loop_filter_across_tiles_enabled_flag = 0,
+    .loop_filter_across_slices_enabled_flag = 1,
+
+    .deblocking_filter_control_present_flag = 0,
+    .deblocking_filter_override_enabled_flag = 0,
+    .deblocking_filter_disabled_flag = 0,
+    .beta_offset_div2 = 0,
+    .tc_offset_div2 = 0,
+
+    .scaling_list_data_present_flag = 0,
+    .lists_modification_present_flag = 0,
+    .log2_parallel_merge_level_minus2 = 0,
+    .slice_segment_header_extension_present_flag = 0,
+  };
+  /* *INDENT-ON* */
+}
