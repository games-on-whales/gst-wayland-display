+static void
+gst_vulkan_h265_encoder_frame_free (gpointer frame)
+{
+  GstVulkanH265EncoderFrame *vkframe = frame;
+  gst_vulkan_encoder_picture_clear (&vkframe->picture, vkframe->encoder);
+  gst_object_unref (vkframe->encoder);
+  g_free (vkframe);
+}
