+static gboolean
+gst_vulkan_h265_encoder_init_std_sps (GstVulkanH265Encoder * self,
+    GstH265SPS * sps)
+{
+  GstVulkanVideoCapabilities vk_caps;
+  GstH265Profile profile = (GstH265Profile) sps->profile_tier_level.profile_idc;
+  guint ctb_log2_size, min_tb_log2_size, max_tb_log2_size;
+  guint disp_w, disp_h, cw_right, cw_bottom;
+
+  if (!gst_vulkan_encoder_caps (self->encoder, &vk_caps))
+    return FALSE;
+
+  /* The SPS picture is the coded (CTB-aligned) size that the encoder actually
+   * tiles; the conformance window crops it back to the display size. Declaring
+   * the display size directly leaves a partial bottom/right CTB row that the
+   * driver fills with garbage (a green bar). 4:2:0 -> SubWidthC/HeightC = 2. */
+  disp_w = GST_VIDEO_INFO_WIDTH (&self->in_state->info);
+  disp_h = GST_VIDEO_INFO_HEIGHT (&self->in_state->info);
+  cw_right = (self->coded_width - disp_w) >> 1;
+  cw_bottom = (self->coded_height - disp_h) >> 1;
+
+  if (sps->profile_tier_level.level_idc == 0xff)
+    return FALSE;
+
+  /* The coding-tree-block and transform-block geometry written into the SPS
+   * must match what the driver actually encodes with, otherwise the bitstream
+   * is internally inconsistent and decoders reconstruct garbage. Derive it
+   * from the encoder's reported capabilities instead of hardcoding. */
+  {
+    VkVideoEncodeH265CapabilitiesKHR *h265c = &vk_caps.encoder.codec.h265;
+
+    if (h265c->ctbSizes & VK_VIDEO_ENCODE_H265_CTB_SIZE_64_BIT_KHR)
+      ctb_log2_size = 6;
+    else if (h265c->ctbSizes & VK_VIDEO_ENCODE_H265_CTB_SIZE_32_BIT_KHR)
+      ctb_log2_size = 5;
+    else
+      ctb_log2_size = 4;
+
+    if (h265c->transformBlockSizes & VK_VIDEO_ENCODE_H265_TRANSFORM_BLOCK_SIZE_4_BIT_KHR)
+      min_tb_log2_size = 2;
+    else if (h265c->transformBlockSizes & VK_VIDEO_ENCODE_H265_TRANSFORM_BLOCK_SIZE_8_BIT_KHR)
+      min_tb_log2_size = 3;
+    else if (h265c->transformBlockSizes & VK_VIDEO_ENCODE_H265_TRANSFORM_BLOCK_SIZE_16_BIT_KHR)
+      min_tb_log2_size = 4;
+    else
+      min_tb_log2_size = 5;
+
+    if (h265c->transformBlockSizes & VK_VIDEO_ENCODE_H265_TRANSFORM_BLOCK_SIZE_32_BIT_KHR)
+      max_tb_log2_size = 5;
+    else if (h265c->transformBlockSizes & VK_VIDEO_ENCODE_H265_TRANSFORM_BLOCK_SIZE_16_BIT_KHR)
+      max_tb_log2_size = 4;
+    else if (h265c->transformBlockSizes & VK_VIDEO_ENCODE_H265_TRANSFORM_BLOCK_SIZE_8_BIT_KHR)
+      max_tb_log2_size = 3;
+    else
+      max_tb_log2_size = 2;
+
+    GST_INFO_OBJECT (self, "encoder geometry: CtbSize=%u minTB=%u maxTB=%u "
+        "transform-hierarchy=%u", 1 << ctb_log2_size, 1 << min_tb_log2_size,
+        1 << max_tb_log2_size, ctb_log2_size - min_tb_log2_size);
+  }
+
+  gst_vulkan_h265_encoder_init_std_ptl (self, &sps->profile_tier_level);
+  gst_vulkan_h265_encoder_init_std_dpbm (self, sps->max_dec_pic_buffering_minus1,
+      sps->max_num_reorder_pics, sps->max_latency_increase_plus1);
+  memset (&self->params.strps, 0, sizeof (self->params.strps));
+
+  /* *INDENT-OFF* */
+  self->params.sps = (StdVideoH265SequenceParameterSet) {
+    .flags = (StdVideoH265SpsFlags) {
+      .sps_temporal_id_nesting_flag = sps->temporal_id_nesting_flag,
+      .separate_colour_plane_flag = sps->separate_colour_plane_flag,
+      .conformance_window_flag = (cw_right || cw_bottom) ? 1 : 0,
+      .sps_sub_layer_ordering_info_present_flag =
+          sps->sub_layer_ordering_info_present_flag,
+      .scaling_list_enabled_flag = sps->scaling_list_enabled_flag,
+      .sps_scaling_list_data_present_flag = sps->scaling_list_data_present_flag,
+      .amp_enabled_flag = sps->amp_enabled_flag,
+      .sample_adaptive_offset_enabled_flag =
+          sps->sample_adaptive_offset_enabled_flag,
+      .pcm_enabled_flag = sps->pcm_enabled_flag,
+      .pcm_loop_filter_disabled_flag = sps->pcm_loop_filter_disabled_flag,
+      .long_term_ref_pics_present_flag = sps->long_term_ref_pics_present_flag,
+      .sps_temporal_mvp_enabled_flag = sps->temporal_mvp_enabled_flag,
+      .strong_intra_smoothing_enabled_flag =
+          sps->strong_intra_smoothing_enabled_flag,
+      .vui_parameters_present_flag = sps->vui_parameters_present_flag,
+      .sps_extension_present_flag = sps->sps_extension_flag,
+    },
+    .chroma_format_idc = (StdVideoH265ChromaFormatIdc) sps->chroma_format_idc,
+    .pic_width_in_luma_samples = self->coded_width,
+    .pic_height_in_luma_samples = self->coded_height,
+    .sps_video_parameter_set_id = sps->vps_id,
+    .sps_max_sub_layers_minus1 = sps->max_sub_layers_minus1,
+    .sps_seq_parameter_set_id = sps->id,
+    .bit_depth_luma_minus8 = sps->bit_depth_luma_minus8,
+    .bit_depth_chroma_minus8 = sps->bit_depth_chroma_minus8,
+    .log2_max_pic_order_cnt_lsb_minus4 = sps->log2_max_pic_order_cnt_lsb_minus4,
+    /* Geometry derived from the encoder caps above (MinCbSizeY fixed at 8). */
+    .log2_min_luma_coding_block_size_minus3 = 0,
+    .log2_diff_max_min_luma_coding_block_size = ctb_log2_size - 3,
+    .log2_min_luma_transform_block_size_minus2 = min_tb_log2_size - 2,
+    .log2_diff_max_min_luma_transform_block_size =
+        max_tb_log2_size - min_tb_log2_size,
+    .max_transform_hierarchy_depth_inter = ctb_log2_size - min_tb_log2_size,
+    .max_transform_hierarchy_depth_intra = ctb_log2_size - min_tb_log2_size,
+    .num_short_term_ref_pic_sets = sps->num_short_term_ref_pic_sets,
+    .num_long_term_ref_pics_sps = sps->num_long_term_ref_pics_sps,
+    .pcm_sample_bit_depth_luma_minus1 = sps->pcm_sample_bit_depth_luma_minus1,
+    .pcm_sample_bit_depth_chroma_minus1 =
+        sps->pcm_sample_bit_depth_chroma_minus1,
+    .log2_min_pcm_luma_coding_block_size_minus3 =
+        sps->log2_min_pcm_luma_coding_block_size_minus3,
+    .log2_diff_max_min_pcm_luma_coding_block_size =
+        sps->log2_diff_max_min_pcm_luma_coding_block_size,
+    .conf_win_left_offset = 0,
+    .conf_win_right_offset = cw_right,
+    .conf_win_top_offset = 0,
+    .conf_win_bottom_offset = cw_bottom,
+    .pProfileTierLevel = &self->params.ptl,
+    .pDecPicBufMgr = &self->params.dpbm,
+    .pScalingLists = NULL,
+    .pShortTermRefPicSet = &self->params.strps,
+    .pLongTermRefPicsSps = NULL,
+    .pSequenceParameterSetVui = NULL,
+    .pPredictorPaletteEntries = NULL,
+  };
+  /* *INDENT-ON* */
+
+  if (self->rc.bitrate == 0) {
+    const GstH265LevelDescriptor *desc;
+
+    desc = gst_h265_get_level_descriptor (profile, 0, &self->in_state->info,
+        sps->max_dec_pic_buffering_minus1[sps->max_sub_layers_minus1] + 1);
+    if (!desc)
+      return FALSE;
+
+    self->rc.bitrate =
+        desc->max_br_main * gst_h265_get_cpb_nal_factor (profile) / 1024;
+  }
+
+  _configure_rate_control (self, &vk_caps);
+
+  if (sps->vui_parameters_present_flag) {
+    GstH265VUIParams *vui = &sps->vui_params;
+
+    /* *INDENT-OFF* */
+    self->params.vui = (StdVideoH265SequenceParameterSetVui) {
+      .flags = (StdVideoH265SpsVuiFlags) {
+        .aspect_ratio_info_present_flag = vui->aspect_ratio_info_present_flag,
+        .overscan_info_present_flag = vui->overscan_info_present_flag,
+        .overscan_appropriate_flag = vui->overscan_appropriate_flag,
+        .video_signal_type_present_flag = vui->video_signal_type_present_flag,
+        .video_full_range_flag = vui->video_full_range_flag,
+        .colour_description_present_flag = vui->colour_description_present_flag,
+        .chroma_loc_info_present_flag = vui->chroma_loc_info_present_flag,
+        .neutral_chroma_indication_flag = vui->neutral_chroma_indication_flag,
+        .field_seq_flag = vui->field_seq_flag,
+        .frame_field_info_present_flag = vui->frame_field_info_present_flag,
+        .default_display_window_flag = vui->default_display_window_flag,
+        .vui_timing_info_present_flag = vui->timing_info_present_flag,
+        .vui_poc_proportional_to_timing_flag =
+            vui->poc_proportional_to_timing_flag,
+        .vui_hrd_parameters_present_flag = vui->hrd_parameters_present_flag,
+        .bitstream_restriction_flag = vui->bitstream_restriction_flag,
+        .tiles_fixed_structure_flag = vui->tiles_fixed_structure_flag,
+        .motion_vectors_over_pic_boundaries_flag =
+            vui->motion_vectors_over_pic_boundaries_flag,
+        .restricted_ref_pic_lists_flag = vui->restricted_ref_pic_lists_flag,
+      },
+      .aspect_ratio_idc = (StdVideoH265AspectRatioIdc) vui->aspect_ratio_idc,
+      .sar_width = vui->sar_width,
+      .sar_height = vui->sar_height,
+      .video_format = vui->video_format,
+      .colour_primaries = vui->colour_primaries,
+      .transfer_characteristics = vui->transfer_characteristics,
+      .matrix_coeffs = vui->matrix_coefficients,
+      .chroma_sample_loc_type_top_field = vui->chroma_sample_loc_type_top_field,
+      .chroma_sample_loc_type_bottom_field =
+          vui->chroma_sample_loc_type_bottom_field,
+      .def_disp_win_left_offset = vui->def_disp_win_left_offset,
+      .def_disp_win_right_offset = vui->def_disp_win_right_offset,
+      .def_disp_win_top_offset = vui->def_disp_win_top_offset,
+      .def_disp_win_bottom_offset = vui->def_disp_win_bottom_offset,
+      .vui_num_units_in_tick = vui->num_units_in_tick,
+      .vui_time_scale = vui->time_scale,
+      .vui_num_ticks_poc_diff_one_minus1 = vui->num_ticks_poc_diff_one_minus1,
+      .min_spatial_segmentation_idc = vui->min_spatial_segmentation_idc,
+      .max_bytes_per_pic_denom = vui->max_bytes_per_pic_denom,
+      .max_bits_per_min_cu_denom = vui->max_bits_per_min_cu_denom,
+      .log2_max_mv_length_horizontal = vui->log2_max_mv_length_horizontal,
+      .log2_max_mv_length_vertical = vui->log2_max_mv_length_vertical,
+      .pHrdParameters = NULL,
+    };
+    /* *INDENT-ON* */
+
+    self->params.sps.pSequenceParameterSetVui = &self->params.vui;
+  }
+
+  return TRUE;
+}
+
+static void
+gst_vulkan_h265_encoder_init_std_vps (GstVulkanH265Encoder * self,
+    GstH265VPS * vps)
