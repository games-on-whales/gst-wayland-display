+/**
+ * gst_h265_get_cpb_nal_factor:
+ * @profile: a #GstH265Profile
+ *
+ * The values comes from Table A-2 + H.10.2.1
+ *
+ * Returns: the bitrate NAL factor of the coded picture buffer.
+ *
+ * Since: 1.28
+ */
+guint
+gst_h265_get_cpb_nal_factor (GstH265Profile profile)
+{
+  for (int i = 0; i < G_N_ELEMENTS (_h265_nal_factors); i++) {
+    if (_h265_nal_factors[i].profile == profile)
+      return _h265_nal_factors[i].cpb_br_nal_factor;
+  }
+
+  /* default to non-high profile */
+  return 1200;
+}
+
+/**
+ * gst_h265_get_level_descriptor:
+ * @profile: a #GstH265Profile
+ * @bitrate: bit rate in bytes per second
+ * @in_info: raw stream's #GstVideoInfo
+ * @max_dec_frame_buffering: the max size of DPB
+ *
+ * Returns: #GStH265LevelDescriptor associated with associated with @profile,
+ *   @bitrate, framesize and framerate in @in_info, and
+ *   @max_dec_frame_buffering. If no descriptor found, it returns %NULL.
+ *
+ * Since: 1.28
+ */
+const GstH265LevelDescriptor *
+gst_h265_get_level_descriptor (GstH265Profile profile, guint64 bitrate,
+    GstVideoInfo * in_info, int max_dec_frame_buffering)
+{
+  guint cpb_factor;
+  guint32 i;
+  guint64 lumaPs, maxLumaSr;
+
+  g_return_val_if_fail (in_info, NULL);
+
+  cpb_factor = gst_h265_get_cpb_nal_factor (profile);
+
+  /* PicSizeInSamplesY: each dimension rounded up to MinCbSizeY (8). */
+  lumaPs = (guint64) GST_ROUND_UP_8 (GST_VIDEO_INFO_WIDTH (in_info)) *
+      GST_ROUND_UP_8 (GST_VIDEO_INFO_HEIGHT (in_info));
+
+  if (GST_VIDEO_INFO_FPS_N (in_info) > 0 && GST_VIDEO_INFO_FPS_D (in_info) > 0) {
+    maxLumaSr = gst_util_uint64_scale_int_ceil (lumaPs,
+        GST_VIDEO_INFO_FPS_N (in_info), GST_VIDEO_INFO_FPS_D (in_info));
+  } else {
+    maxLumaSr = 0;
+  }
+
+  for (i = 0; i < G_N_ELEMENTS (_h265_levels); i++) {
+    const GstH265LevelDescriptor *level = &_h265_levels[i];
+    /* A.4.2: MaxDpbSize from PicSizeInSamplesY relative to MaxLumaPs,
+     * with maxDpbPicBuf = 6 for non-still-picture profiles. */
+    guint32 maxDpbSize;
+
+    if (bitrate > (guint64) level->max_br_main * cpb_factor)
+      continue;
+    if (lumaPs > level->max_luma_ps)
+      continue;
+    if (maxLumaSr > level->max_luma_sr)
+      continue;
+
+    if (lumaPs > 0) {
+      if (lumaPs <= (level->max_luma_ps >> 2))
+        maxDpbSize = MIN (4 * 6, 16);
+      else if (lumaPs <= (level->max_luma_ps >> 1))
+        maxDpbSize = MIN (2 * 6, 16);
+      else if (lumaPs <= (3 * (level->max_luma_ps >> 2)))
+        maxDpbSize = MIN ((4 * 6) / 3, 16);
+      else
+        maxDpbSize = 6;
+
+      if ((guint32) max_dec_frame_buffering > maxDpbSize)
+        continue;
+    }
+
+    return level;
+  }
+
+  GST_ERROR ("Failed to find a suitable level: "
+      "frame is too big or bitrate too high");
+  return NULL;
+}
+
+/* Maximum sizes for common headers (in bits) */
+#define MAX_SPS_HDR_SIZE    16473
+#define MAX_VUI_PARAMS_SIZE 210
+#define MAX_HRD_PARAMS_SIZE 4103
+#define MAX_PPS_HDR_SIZE    101
+#define MAX_SLICE_HDR_SIZE  397 + 2572 + 6670 + 2402
+
+/**
+ * gst_h265_calculate_coded_size:
+ * @sps: the #GstH265SPS
+ * @num_slices: number of slices to encode per frame
+ *
+ * Returns the calculated size of the encoded buffer.
+ *
+ * Since: 1.28
+ */
+gsize
+gst_h265_calculate_coded_size (GstH265SPS * sps, guint num_slices)
+{
+  gsize codedbuf_size;
+  guint width, height, chroma_subsampling, bits_per_luma_sample;
+  guint8 bit_depth_luma, bit_depth_chroma;
+
+  g_return_val_if_fail (sps && num_slices >= 1, 0);
+
+  width = sps->pic_width_in_luma_samples;
+  height = sps->pic_height_in_luma_samples;
+  chroma_subsampling = sps->chroma_format_idc;
+  bit_depth_luma = sps->bit_depth_luma_minus8 + 8;
+  bit_depth_chroma = sps->bit_depth_chroma_minus8 + 8;
+
+  /* Generous worst-case raw bits carried per luma sample, including the chroma
+   * planes for the chroma format. This is a coded-buffer upper bound, not a
+   * rate target: 4:2:0 carries one Cb and one Cr sample per four luma samples
+   * (so +1/2 chroma bit-depth per luma sample), 4:2:2 +1, 4:4:4 +2. */
+  switch (chroma_subsampling) {
+    case 2:                     /* 4:2:2 */
+      bits_per_luma_sample = bit_depth_luma + 2 * bit_depth_chroma;
+      break;
+    case 3:                     /* 4:4:4 */
+      bits_per_luma_sample = bit_depth_luma + 4 * bit_depth_chroma;
+      break;
+    case 1:                     /* 4:2:0 */
+    default:
+      bits_per_luma_sample = bit_depth_luma + bit_depth_chroma;
+      break;
+  }
+
+  codedbuf_size = ((gsize) width * height * bits_per_luma_sample) / 8;
+
+  /* Account for VPS + SPS + PPS + per-slice headers (HEVC has a VPS that H.264
+   * lacks; allow a fixed slack for it plus the NAL start codes). */
+  codedbuf_size += 128;         /* VPS + NAL start-code slack */
+  codedbuf_size += 4 + GST_ROUND_UP_8 (MAX_SPS_HDR_SIZE +
+      MAX_VUI_PARAMS_SIZE + 2 * MAX_HRD_PARAMS_SIZE) / 8;
+  codedbuf_size += 4 + GST_ROUND_UP_8 (MAX_PPS_HDR_SIZE) / 8;
+  codedbuf_size += num_slices * (4 + GST_ROUND_UP_8 (MAX_SLICE_HDR_SIZE) / 8);
+
+  /* Add ceil 5% for safety. */
+  codedbuf_size = (gsize) (((gdouble) codedbuf_size * 1.05) + 1);
+
+  return codedbuf_size;
+}
