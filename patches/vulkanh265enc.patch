+/**
+ * gst_h265_encoder_frame_get_user_data:
+ * @frame: a #GstH265EncoderFrame
+ *
+ * Gets private data set on the frame by the subclass via
+ * gst_video_codec_frame_set_user_data() previously.
+ *
+ * Returns: (transfer none): The previously set user_data
+ */
+
+
+struct PyramidInfo
+{
+  guint level;
+  gint left_ref_poc_diff;
+  gint right_ref_poc_diff;
+};
+
+/* recursive function */
+static void
+gst_h265_encoder_set_pyramid_info (struct PyramidInfo *info, guint len,
+    guint current_level, guint highest_level)
+{
+  guint index;
+
+  g_assert (len >= 1 && len <= 31);
+
+  if (current_level == highest_level || len == 1) {
+    for (index = 0; index < len; index++) {
+      info[index].level = current_level;
+      info[index].left_ref_poc_diff = (index + 1) * -2;
+      info[index].right_ref_poc_diff = (len - index) * 2;
+    }
+
+    return;
+  }
+
+  index = len / 2;
+  info[index].level = current_level;
+  info[index].left_ref_poc_diff = (index + 1) * -2;
+  info[index].right_ref_poc_diff = (len - index) * 2;
+
+  current_level++;
+
+  if (index > 0) {
+    gst_h265_encoder_set_pyramid_info (info, index, current_level,
+        highest_level);
+  }
+
+  if (index + 1 < len) {
+    gst_h265_encoder_set_pyramid_info (&info[index + 1], len - (index + 1),
+        current_level, highest_level);
+  }
+}
