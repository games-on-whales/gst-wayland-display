+          pps->dependent_slice_segments_enabled_flag,
+      .output_flag_present_flag = pps->output_flag_present_flag,
+      .sign_data_hiding_enabled_flag = pps->sign_data_hiding_enabled_flag,
+      .cabac_init_present_flag = pps->cabac_init_present_flag,
+      .constrained_intra_pred_flag = pps->constrained_intra_pred_flag,
+      .transform_skip_enabled_flag = pps->transform_skip_enabled_flag,
+      .cu_qp_delta_enabled_flag = pps->cu_qp_delta_enabled_flag,
+      .pps_slice_chroma_qp_offsets_present_flag =
+          pps->slice_chroma_qp_offsets_present_flag,
+      .weighted_pred_flag = pps->weighted_pred_flag,
+      .weighted_bipred_flag = pps->weighted_bipred_flag,
+      .transquant_bypass_enabled_flag = pps->transquant_bypass_enabled_flag,
+      /* B9: single slice/picture, no tiles and no WPP */
+      .tiles_enabled_flag = 0,
+      .entropy_coding_sync_enabled_flag = 0,
+      .uniform_spacing_flag = pps->uniform_spacing_flag,
+      .loop_filter_across_tiles_enabled_flag =
+          pps->loop_filter_across_tiles_enabled_flag,
+      .pps_loop_filter_across_slices_enabled_flag =
+          pps->loop_filter_across_slices_enabled_flag,
+      .deblocking_filter_control_present_flag =
+          pps->deblocking_filter_control_present_flag,
+      .deblocking_filter_override_enabled_flag =
+          pps->deblocking_filter_override_enabled_flag,
+      .pps_deblocking_filter_disabled_flag =
+          pps->deblocking_filter_disabled_flag,
+      .pps_scaling_list_data_present_flag =
+          pps->scaling_list_data_present_flag,
+      .lists_modification_present_flag = pps->lists_modification_present_flag,
+      .slice_segment_header_extension_present_flag =
+          pps->slice_segment_header_extension_present_flag,
+      .pps_extension_present_flag = pps->pps_extension_flag,
+    },
+    .pps_pic_parameter_set_id = pps->id,
+    .pps_seq_parameter_set_id = pps->sps_id,
+    .sps_video_parameter_set_id = vps_id,
+    .num_extra_slice_header_bits = pps->num_extra_slice_header_bits,
+    .num_ref_idx_l0_default_active_minus1 =
+        pps->num_ref_idx_l0_default_active_minus1,
+    .num_ref_idx_l1_default_active_minus1 =
+        pps->num_ref_idx_l1_default_active_minus1,
+    .init_qp_minus26 = pps->init_qp_minus26,
+    .diff_cu_qp_delta_depth = pps->diff_cu_qp_delta_depth,
+    .pps_cb_qp_offset = pps->cb_qp_offset,
+    .pps_cr_qp_offset = pps->cr_qp_offset,
+    .pps_beta_offset_div2 = pps->beta_offset_div2,
+    .pps_tc_offset_div2 = pps->tc_offset_div2,
+    .log2_parallel_merge_level_minus2 = pps->log2_parallel_merge_level_minus2,
+    .num_tile_columns_minus1 = pps->num_tile_columns_minus1,
+    .num_tile_rows_minus1 = pps->num_tile_rows_minus1,
+    .pScalingLists = NULL,
+    .pPredictorPaletteEntries = NULL,
+  };
+  /* *INDENT-ON* */
+
+  return TRUE;
+}
+
+static VkVideoChromaSubsamplingFlagBitsKHR
+_h265_get_chroma_subsampling (GstVideoInfo * info)
+{
+  gint w_sub, h_sub;
+
+  w_sub = 1 << GST_VIDEO_FORMAT_INFO_W_SUB (info->finfo, 1);
+  h_sub = 1 << GST_VIDEO_FORMAT_INFO_H_SUB (info->finfo, 1);
+
+  if (w_sub == 2 && h_sub == 2)
+    return VK_VIDEO_CHROMA_SUBSAMPLING_420_BIT_KHR;
+  else if (w_sub == 2 && h_sub == 1)
+    return VK_VIDEO_CHROMA_SUBSAMPLING_422_BIT_KHR;
+  else if (w_sub == 1 && h_sub == 1)
+    return VK_VIDEO_CHROMA_SUBSAMPLING_444_BIT_KHR;
+
+  g_assert_not_reached ();
+}
+
+static GstFlowReturn
+gst_vulkan_h265_encoder_new_sequence (GstH265Encoder * encoder,
+    GstVideoCodecState * in_state, GstH265Profile profile, guint8 tier,
+    guint8 * level_idc)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (encoder);
+  GError *err = NULL;
+  GstVideoInfo *in_info = &in_state->info;
+  VkVideoChromaSubsamplingFlagBitsKHR chroma_subsampling;
+  VkVideoComponentBitDepthFlagsKHR bit_depth_luma, bit_depth_chroma;
+  StdVideoH265ProfileIdc vk_profile;
+  GstVulkanVideoCapabilities vk_caps;
+  VkVideoEncodeH265CapabilitiesKHR *vk_h265_caps;
+  GstVulkanEncoderQualityProperties quality_props;
+
+  if (!self->encoder) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NOT_FOUND,
+        ("The vulkan encoder has not been initialized properly"), (NULL));
+    return GST_FLOW_ERROR;
+  }
+
+  /* profile configuration */
+  {
+    chroma_subsampling = _h265_get_chroma_subsampling (in_info);
+    bit_depth_luma =
+        gst_vulkan_h265_bit_depth (GST_VIDEO_INFO_COMP_DEPTH (in_info, 0));
+    g_assert (bit_depth_luma != VK_VIDEO_COMPONENT_BIT_DEPTH_INVALID_KHR);
+    bit_depth_chroma =
+        gst_vulkan_h265_bit_depth (GST_VIDEO_INFO_COMP_DEPTH (in_info, 1));
+    g_assert (bit_depth_chroma != VK_VIDEO_COMPONENT_BIT_DEPTH_INVALID_KHR);
+
+    vk_profile = gst_vulkan_h265_profile_type (profile);
+
+    /* *INDENT-OFF* */
+    self->profile = (GstVulkanVideoProfile) {
+      .profile = (VkVideoProfileInfoKHR) {
+        .sType = VK_STRUCTURE_TYPE_VIDEO_PROFILE_INFO_KHR,
+        .pNext = &self->profile.usage.encode,
+        .videoCodecOperation = VK_VIDEO_CODEC_OPERATION_ENCODE_H265_BIT_KHR,
+        .chromaSubsampling = chroma_subsampling,
+        .chromaBitDepth = bit_depth_chroma,
+        .lumaBitDepth = bit_depth_luma,
+      },
+      .usage.encode = (VkVideoEncodeUsageInfoKHR) {
+        .pNext = &self->profile.codec.h265enc,
+        .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_USAGE_INFO_KHR,
+        .videoUsageHints = VK_VIDEO_ENCODE_USAGE_DEFAULT_KHR,
+        .videoContentHints = VK_VIDEO_ENCODE_CONTENT_DEFAULT_KHR,
+        .tuningMode = VK_VIDEO_ENCODE_TUNING_MODE_DEFAULT_KHR,
+      },
+      .codec.h265enc = (VkVideoEncodeH265ProfileInfoKHR) {
+        .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_PROFILE_INFO_KHR,
+        .stdProfileIdc = vk_profile,
+      },
+    };
+    quality_props =  (GstVulkanEncoderQualityProperties) {
+      .quality_level = self->rc.quality,
+      .codec.h265 = {
+        .sType =
+            VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_QUALITY_LEVEL_PROPERTIES_KHR,
+      },
+    };
+    /* *INDENT-ON* */
+  }
+
+  /* Refresh in_state up-front, BEFORE the same-profile early-return below, so a
+   * colorimetry-only mid-stream change (dynamic SDR<->HDR: bt709 <-> bt2100-pq, plus
+   * the mastering/CLL caps fields) updates the source the VUI + HDR SEI are built from
+   * (_set_vui_colour_description / _write_hdr_sei read self->in_state). Previously this
+   * lived after the early-return, so same-profile colorimetry flips kept stale in_state
+   * and the emitted VUI never changed. */
+  if (self->in_state)
+    gst_video_codec_state_unref (self->in_state);
+  self->in_state = gst_video_codec_state_ref (in_state);
+
+  if (gst_vulkan_encoder_is_started (self->encoder)) {
+    if (self->profile.profile.chromaSubsampling == chroma_subsampling
+        && self->profile.profile.chromaBitDepth == bit_depth_chroma
+        && self->profile.profile.lumaBitDepth == bit_depth_luma
+        && self->profile.codec.h265enc.stdProfileIdc == vk_profile) {
+      return GST_FLOW_OK;
+    } else {
+      GST_DEBUG_OBJECT (self, "Restarting vulkan encoder");
+      gst_vulkan_encoder_stop (self->encoder);
+    }
+  }
+
+  if (!gst_vulkan_encoder_start (self->encoder, &self->profile, &quality_props,
+          &err)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NOT_FOUND,
+        ("Unable to start vulkan encoder with error %s", err->message), (NULL));
+    g_clear_error (&err);
+    return GST_FLOW_ERROR;
+  }
+
+  /* Create the DPB pool here (after the encoder is started) instead of in
+   * propose_allocation. Under interpipesrc the allocation query reaches the
+   * encoder before its caps/set_format event, so the encoder is not yet
+   * started and create_dpb_pool fails. */
+  if (!gst_vulkan_encoder_create_dpb_pool (self->encoder, in_state->caps)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NOT_FOUND,
+        ("Unable to create the dpb pool"), (NULL));
+    return GST_FLOW_ERROR;
+  }
+
+  /* quality configuration */
+  {
+    self->rc.quality = gst_vulkan_encoder_quality_level (self->encoder);
+    update_property_uint (self, &self->prop.quality, self->rc.quality,
+        PROP_QUALITY);
+    self->rc.ratecontrol = gst_vulkan_encoder_rc_mode (self->encoder);
+    update_property_uint (self, &self->prop.ratecontrol, self->rc.ratecontrol,
+        PROP_RATECONTROL);
+  }
+
+  gst_vulkan_encoder_caps (self->encoder, &vk_caps);
+  vk_h265_caps = &vk_caps.encoder.codec.h265;
+
+  GST_LOG_OBJECT (self, "H265 encoder capabilities:\n"
+      "    Standard capability flags:\n"
+      "        separate_color_plane: %i\n"
+      "        sample_adaptive_offset: %i\n"
+      "        pic_init_qp: %i\n"
+      "        weighted_pred: %i\n"
+      "        weighted_bipred: %i\n"
+      "        transform_skip: %i\n"
+      "        constrained_intra_pred: %i\n"
+      "    Capability flags:\n"
+      "        hdr_compliance: %i\n"
+      "        pred_weight_table_generated: %i\n"
+      "        row_unaligned_slice_segment: %i\n"
+      "        different_slice_segment_type: %i\n"
+      "        b_frame_in_l0_list: %i\n"
+      "        b_frame_in_l1_list: %i\n"
+      "        per_pict_type_min_max_qp: %i\n"
+      "        per_slice_segment_constant_qp: %i\n"
+      "    Capabilities:\n"
+      "        maxLevelIdc: %i\n"
+      "        maxSliceSegmentCount: %i\n"
+      "        max(P/B)PictureL0ReferenceCount: %i P / %i B\n"
+      "        maxL1ReferenceCount: %i\n"
+      "        maxSubLayerCount: %i\n"
+      "        expectDyadicTemporalSubLayerPattern: %i\n"
+      "        min/max Qp: [%i, %i]\n"
+      "        prefersGopRemainingFrames: %i\n"
+      "        requiresGopRemainingFrames: %i\n",
+      !!(vk_h265_caps->stdSyntaxFlags &
+          VK_VIDEO_ENCODE_H265_STD_SEPARATE_COLOR_PLANE_FLAG_SET_BIT_KHR),
+      !!(vk_h265_caps->stdSyntaxFlags &
+          VK_VIDEO_ENCODE_H265_STD_SAMPLE_ADAPTIVE_OFFSET_ENABLED_FLAG_SET_BIT_KHR),
+      !!(vk_h265_caps->stdSyntaxFlags &
+          VK_VIDEO_ENCODE_H265_STD_INIT_QP_MINUS26_BIT_KHR),
+      !!(vk_h265_caps->stdSyntaxFlags &
+          VK_VIDEO_ENCODE_H265_STD_WEIGHTED_PRED_FLAG_SET_BIT_KHR),
+      !!(vk_h265_caps->stdSyntaxFlags &
+          VK_VIDEO_ENCODE_H265_STD_WEIGHTED_BIPRED_FLAG_SET_BIT_KHR),
+      !!(vk_h265_caps->stdSyntaxFlags &
+          VK_VIDEO_ENCODE_H265_STD_TRANSFORM_SKIP_ENABLED_FLAG_SET_BIT_KHR),
+      !!(vk_h265_caps->stdSyntaxFlags &
+          VK_VIDEO_ENCODE_H265_STD_CONSTRAINED_INTRA_PRED_FLAG_SET_BIT_KHR),
+      !!(vk_h265_caps->flags &
+          VK_VIDEO_ENCODE_H265_CAPABILITY_HRD_COMPLIANCE_BIT_KHR),
+      !!(vk_h265_caps->flags &
+          VK_VIDEO_ENCODE_H265_CAPABILITY_PREDICTION_WEIGHT_TABLE_GENERATED_BIT_KHR),
+      !!(vk_h265_caps->flags &
+          VK_VIDEO_ENCODE_H265_CAPABILITY_ROW_UNALIGNED_SLICE_SEGMENT_BIT_KHR),
+      !!(vk_h265_caps->flags &
+          VK_VIDEO_ENCODE_H265_CAPABILITY_DIFFERENT_SLICE_SEGMENT_TYPE_BIT_KHR),
+      !!(vk_h265_caps->flags &
+          VK_VIDEO_ENCODE_H265_CAPABILITY_B_FRAME_IN_L0_LIST_BIT_KHR),
+      !!(vk_h265_caps->flags &
+          VK_VIDEO_ENCODE_H265_CAPABILITY_B_FRAME_IN_L1_LIST_BIT_KHR),
+      !!(vk_h265_caps->flags &
+          VK_VIDEO_ENCODE_H265_CAPABILITY_PER_PICTURE_TYPE_MIN_MAX_QP_BIT_KHR),
+      !!(vk_h265_caps->flags &
+          VK_VIDEO_ENCODE_H265_CAPABILITY_PER_SLICE_SEGMENT_CONSTANT_QP_BIT_KHR),
+      vk_h265_caps->maxLevelIdc,
+      vk_h265_caps->maxSliceSegmentCount,
+      vk_h265_caps->maxPPictureL0ReferenceCount,
+      vk_h265_caps->maxBPictureL0ReferenceCount,
+      vk_h265_caps->maxL1ReferenceCount,
+      vk_h265_caps->maxSubLayerCount,
+      vk_h265_caps->expectDyadicTemporalSubLayerPattern,
+      vk_h265_caps->maxQp, vk_h265_caps->minQp,
+      vk_h265_caps->prefersGopRemainingFrames,
+      vk_h265_caps->requiresGopRemainingFrames);
+
+  if (GST_VIDEO_INFO_WIDTH (in_info) > vk_caps.caps.maxCodedExtent.width
+      || GST_VIDEO_INFO_HEIGHT (in_info) > vk_caps.caps.maxCodedExtent.height
+      || GST_VIDEO_INFO_WIDTH (in_info) < vk_caps.caps.minCodedExtent.width
+      || GST_VIDEO_INFO_HEIGHT (in_info) < vk_caps.caps.minCodedExtent.height) {
+    GST_ERROR_OBJECT (self, "Frame size is out of driver limits");
+    gst_vulkan_encoder_stop (self->encoder);
+    return GST_FLOW_NOT_NEGOTIATED;
+  }
+
+  gst_h265_encoder_set_max_num_references (encoder,
+      vk_h265_caps->maxPPictureL0ReferenceCount,
+      vk_h265_caps->maxL1ReferenceCount);
+
+  if (gst_h265_encoder_is_live (encoder)) {
+    /* low latency */
+    gst_h265_encoder_set_preferred_output_delay (encoder, 0);
+  } else {
+    /* experimental best value for VA */
+    gst_h265_encoder_set_preferred_output_delay (encoder, 4);
+  }
+
+  /* (in_state refresh hoisted to the top of this function so colorimetry-only
+   * mid-stream changes update the VUI/SEI even on the same-profile early-return.) */
+
+  {
+    /* The coded picture tiles whole CTBs and the encode-source image must
+     * cover them, so align to the CTB size — not just the (smaller) encode
+     * input granularity — or the partial bottom/right CTB row is filled with
+     * garbage (a green bar). The conformance window crops to the display size. */
+    guint ctb_size = 16;
+
+    if (vk_h265_caps->ctbSizes & VK_VIDEO_ENCODE_H265_CTB_SIZE_64_BIT_KHR)
+      ctb_size = 64;
+    else if (vk_h265_caps->ctbSizes & VK_VIDEO_ENCODE_H265_CTB_SIZE_32_BIT_KHR)
+      ctb_size = 32;
+
+    self->coded_width = GST_ROUND_UP_N (GST_VIDEO_INFO_WIDTH (in_info),
+        MAX (ctb_size,
+            vk_caps.encoder.caps.encodeInputPictureGranularity.width));
+    self->coded_height = GST_ROUND_UP_N (GST_VIDEO_INFO_HEIGHT (in_info),
+        MAX (ctb_size,
+            vk_caps.encoder.caps.encodeInputPictureGranularity.height));
+  }
+
+  return GST_FLOW_OK;
+}
+
+static gboolean
+_h265_parameters_parse (GstVulkanH265Encoder * self, gpointer data,
+    gsize data_size, GstH265SPS * sps, GstH265PPS * pps)
+{
+  GstH265ParserResult res, pres;
+  GstH265NalUnit nalu = { 0, };
+  GstH265Parser *parser = gst_h265_parser_new ();
+  guint offset = 0;
+
+  do {
+    res =
+        gst_h265_parser_identify_nalu (parser, data, offset, data_size, &nalu);
+    if (res != GST_H265_PARSER_OK && res != GST_H265_PARSER_NO_NAL_END) {
+      GST_WARNING_OBJECT (self, "Failed to parse overridden parameters");
+      gst_h265_parser_free (parser);
+      return FALSE;
+    }
+
+    if (nalu.type == GST_H265_NAL_SPS) {
+      pres = gst_h265_parser_parse_sps (parser, &nalu, sps, FALSE);
+      if (pres != GST_H265_PARSER_OK)
+        GST_WARNING_OBJECT (self, "Failed to parse overridden SPS");
+    } else if (nalu.type == GST_H265_NAL_PPS) {
+      pres = gst_h265_parser_parse_pps (parser, &nalu, pps);
+      if (pres != GST_H265_PARSER_OK)
+        GST_WARNING_OBJECT (self, "Failed to parse overridden PPS");
+    } else {
+      GST_WARNING_OBJECT (self, "Unexpected NAL identified: %d", nalu.type);
+    }
+
+    offset = nalu.offset + nalu.size;
+  } while (res == GST_H265_PARSER_OK);
+
+  gst_h265_parser_free (parser);
+
+  return res == GST_H265_PARSER_OK;
+}
+
+static GstFlowReturn
+gst_vulkan_h265_encoder_update_parameters (GstVulkanH265Encoder * self,
+    GstH265VPS * vps, GstH265SPS * sps, GstH265PPS * pps)
+{
+  GError *err = NULL;
+  GstVulkanEncoderParameters params;
+  VkVideoEncodeH265SessionParametersAddInfoKHR params_add;
+
+  if (!gst_vulkan_h265_encoder_init_std_sps (self, sps))
+    return GST_FLOW_ERROR;
+  if (!gst_vulkan_h265_encoder_init_std_pps (self, pps))
+    return GST_FLOW_ERROR;
+  /* the VPS shares the PTL/DPBM sub-structs filled by init_std_sps, so it must
+   * be initialised after it */
+  gst_vulkan_h265_encoder_init_std_vps (self, vps);
+
+  /* *INDENT-OFF* */
+  params_add = (VkVideoEncodeH265SessionParametersAddInfoKHR) {
+    .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_ADD_INFO_KHR,
+    .pStdVPSs = &self->params.vps,
+    .stdVPSCount = 1,
+    .pStdSPSs = &self->params.sps,
+    .stdSPSCount = 1,
+    .pStdPPSs = &self->params.pps,
+    .stdPPSCount = 1,
+  };
+  params.h265 = (VkVideoEncodeH265SessionParametersCreateInfoKHR) {
+    .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_CREATE_INFO_KHR,
+    .maxStdVPSCount = params_add.stdVPSCount,
+    .maxStdSPSCount = params_add.stdSPSCount,
+    .maxStdPPSCount = params_add.stdPPSCount,
+    .pParametersAddInfo = &params_add,
+  };
+  /* *INDENT-ON* */
+
+  if (!gst_vulkan_encoder_update_video_session_parameters (self->encoder,
+          &params, &err)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NOT_FOUND,
+        ("Unable to update session parameters with error %s", err->message),
+        (NULL));
+    g_clear_error (&err);
+    return GST_FLOW_ERROR;
+  }
+
+  return GST_FLOW_OK;
+}
+
+/* Reflect the negotiated input colorimetry into the SPS VUI colour
+ * description. This is done for every stream (BT.709 for SDR, BT.2020/PQ for
+ * HDR) - it just signals what the pixels already are. The std SPS copy path in
+ * gst_vulkan_h265_encoder_init_std_sps() forwards these fields to the Vulkan
+ * StdVideo VUI, and gst_h265_bit_writer_sps() writes them into the bitstream. */
+static void
+_set_vui_colour_description (GstVulkanH265Encoder * self, GstH265SPS * sps)
+{
+  GstH265VUIParams *vui = &sps->vui_params;
+  const GstVideoColorimetry *ci = &self->in_state->info.colorimetry;
+
+  sps->vui_parameters_present_flag = 1;
+  vui->video_signal_type_present_flag = 1;
+  vui->video_format = 5;        /* Unspecified */
+  vui->video_full_range_flag =
+      (ci->range == GST_VIDEO_COLOR_RANGE_0_255) ? 1 : 0;
+  vui->colour_description_present_flag = 1;
+  vui->colour_primaries = gst_video_color_primaries_to_iso (ci->primaries);
+  vui->transfer_characteristics =
+      gst_video_transfer_function_to_iso (ci->transfer);
+  vui->matrix_coefficients = gst_video_color_matrix_to_iso (ci->matrix);
+
+  GST_DEBUG_OBJECT (self, "VUI colour description: primaries=%u transfer=%u "
+      "matrix=%u full-range=%u", vui->colour_primaries,
+      vui->transfer_characteristics, vui->matrix_coefficients,
+      vui->video_full_range_flag);
+}
+
+static GstFlowReturn
+gst_vulkan_h265_encoder_new_parameters (GstH265Encoder * encoder,
+    GstH265VPS * vps, GstH265SPS * sps, GstH265PPS * pps)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (encoder);
+  GError *err = NULL;
+  GstVulkanEncoderParametersOverrides overrides;
+  GstVulkanEncoderParametersFeedback feedback;
+  GstVulkanVideoCapabilities vk_caps;
+  GstFlowReturn ret;
+  gpointer data = NULL;
+  gsize data_size = 0;
+  StdVideoH265LevelIdc vk_max_level;
+
+  if (!self->encoder) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NOT_FOUND,
+        ("The vulkan encoder has not been initialized properly"), (NULL));
+    return GST_FLOW_ERROR;
+  }
+
+  /* gallium drivers always reply 10 level idc  */
+  gst_vulkan_encoder_caps (self->encoder, &vk_caps);
+  vk_max_level = vk_caps.encoder.codec.h265.maxLevelIdc;
+  if (vk_max_level > STD_VIDEO_H265_LEVEL_IDC_1_0) {
+    sps->profile_tier_level.level_idc =
+        MIN (gst_h265_level_idc_from_vk (vk_max_level),
+        sps->profile_tier_level.level_idc);
+  }
+
+  _set_vui_colour_description (self, sps);
+
+  ret = gst_vulkan_h265_encoder_update_parameters (self, vps, sps, pps);
+  if (ret != GST_FLOW_OK)
+    return ret;
+
+  overrides = (GstVulkanEncoderParametersOverrides) {
+    .h265 = {
+      .sType =
+          VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_GET_INFO_KHR,
+      .stdSPSId = self->params.sps.sps_seq_parameter_set_id,
+      .stdPPSId = self->params.pps.pps_pic_parameter_set_id,
+      .writeStdPPS = VK_TRUE,
+      .writeStdSPS = VK_TRUE,
+    }
+  };
+
+  feedback = (GstVulkanEncoderParametersFeedback) {
+    .h265 = {
+      .sType =
+          VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_FEEDBACK_INFO_KHR,
+    }
+  };
+
+  if (!gst_vulkan_encoder_video_session_parameters_overrides (self->encoder,
+          &overrides, &feedback, &data_size, &data, &err))
+    return GST_FLOW_ERROR;
+
+  /* ignore overrides until we get a use case they are actually needed */
+  feedback.h265.hasStdPPSOverrides = feedback.h265.hasStdSPSOverrides = 0;
+
+  if (feedback.h265.hasStdSPSOverrides || feedback.h265.hasStdPPSOverrides) {
+    GstH265SPS new_sps;
+    GstH265PPS new_pps;
+    GST_LOG_OBJECT (self, "Vulkan driver overrode parameters:%s%s",
+        feedback.h265.hasStdSPSOverrides ? " SPS" : "",
+        feedback.h265.hasStdPPSOverrides ? " PPS" : "");
+
+    if (_h265_parameters_parse (self, data, data_size, &new_sps, &new_pps)) {
+      if (feedback.h265.hasStdSPSOverrides)
+        *sps = new_sps;
+
+      if (feedback.h265.hasStdPPSOverrides) {
+        new_pps.sps = sps;
+        *pps = new_pps;
+      }
+
+      ret = gst_vulkan_h265_encoder_update_parameters (self, vps, sps, pps);
+      if (ret != GST_FLOW_OK)
+        return ret;
+    }
+  }
+
+  g_free (data);
+
+  /* copy it to calculate coded buffer size (MVC extension not supported!) */
+  self->vps = *vps;
+  self->sps = *sps;
+  self->pps = *pps;
+  self->sps.vps = &self->vps;
+  self->pps.sps = &self->sps;
+
+  {
+    GstCaps *caps;
+    GstVideoInfo *info = &self->in_state->info;
+    const char *profile, *level;
+    GstVideoCodecState *out_state;
+
+    profile =
+        gst_vulkan_h265_profile_name (self->params.ptl.general_profile_idc);
+    level = gst_vulkan_h265_level_name (self->params.ptl.general_level_idc);
+
+    if (!(profile && level))
+      return GST_FLOW_ERROR;
+
+    caps = gst_caps_new_simple ("video/x-h265", "profile", G_TYPE_STRING,
+        profile, "level", G_TYPE_STRING, level, "width", G_TYPE_INT,
+        GST_VIDEO_INFO_WIDTH (info), "height", G_TYPE_INT,
+        GST_VIDEO_INFO_HEIGHT (info), "alignment", G_TYPE_STRING, "au",
+        "stream-format", G_TYPE_STRING, "byte-stream", NULL);
+
+    out_state =
+        gst_video_encoder_set_output_state (GST_VIDEO_ENCODER_CAST (self),
+        caps, self->in_state);
+    gst_video_codec_state_unref (out_state);
+  }
+
+  return GST_FLOW_OK;
+}
+
+static GstFlowReturn
+gst_vulkan_h265_encoder_new_output (GstH265Encoder * base,
+    GstVideoCodecFrame * codec_frame, GstH265EncoderFrame * h264_frame)
+{
+  GstVulkanH265EncoderFrame *vk_frame;
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (base);
+
+  vk_frame = gst_vulkan_h265_encoder_frame_new (self, codec_frame);
+  if (!vk_frame)
+    return GST_FLOW_NOT_NEGOTIATED;
+
+  gst_h265_encoder_frame_set_user_data (h264_frame, vk_frame,
+      gst_vulkan_h265_encoder_frame_free);
+
+  return GST_FLOW_OK;
+}
+
+/* Emit the HDR10 static-metadata prefix SEI (mastering-display-colour-volume
+ * payload type 137 and content-light-level payload type 144) sourced from the
+ * input caps, into @data. Returns the NAL byte count via @size (0 when there is
+ * no HDR metadata on the caps). The payloads are byte-aligned, so we pack the
+ * RBSP by hand and let gst_h265_bit_writer_convert_to_nal() add the start code
+ * and the emulation-prevention bytes (the in-tree gst_h265_bit_writer_sei()
+ * rejects prefix SEI, so it cannot be used here). */
+static gboolean
+_write_hdr_sei (GstVulkanH265Encoder * self, guint8 * data, guint * size)
+{
+  GstVideoMasteringDisplayInfo minfo;
+  GstVideoContentLightLevel cll;
+  GstCaps *caps = self->in_state->caps;
+  gboolean have_mdcv, have_cll;
+  guint8 raw[128];
+  guint p = 0;
+  GstH265BitWriterResult res;
+
+#define PUT16(v) G_STMT_START { \
+    raw[p++] = ((guint16)(v) >> 8) & 0xff; raw[p++] = (guint16)(v) & 0xff; \
+  } G_STMT_END
+#define PUT32(v) G_STMT_START { \
+    raw[p++] = ((guint32)(v) >> 24) & 0xff; raw[p++] = ((guint32)(v) >> 16) & 0xff; \
+    raw[p++] = ((guint32)(v) >> 8) & 0xff; raw[p++] = (guint32)(v) & 0xff; \
+  } G_STMT_END
+
+  have_mdcv = caps && gst_video_mastering_display_info_from_caps (&minfo, caps);
+  have_cll = caps && gst_video_content_light_level_from_caps (&cll, caps);
+
+  if (!have_mdcv && !have_cll) {
+    *size = 0;
+    return TRUE;
+  }
+
+  /* start code + prefix-SEI NAL header (nal_unit_type 39, layer 0, tid+1 1) */
+  raw[p++] = 0x00;
+  raw[p++] = 0x00;
+  raw[p++] = 0x00;
+  raw[p++] = 0x01;
+  raw[p++] = (GST_H265_NAL_PREFIX_SEI << 1);    /* 0x4E */
+  raw[p++] = 0x01;
+
+  if (have_mdcv) {
+    guint i;
+    /* GstVideoMasteringDisplayInfo::display_primaries is RGB-ordered
+     * (0=R,1=G,2=B); the HEVC SEI (D.3.28) is GBR-ordered (0=G,1=B,2=R).
+     * Luminance is 0.0001 cd/m^2 in both, so it maps directly. Mirrors
+     * gstx265enc.c's "G()B()R()" mapping. */
+    const GstVideoMasteringDisplayInfoCoordinates gbr[3] = {
+      minfo.display_primaries[1],       /* G */
+      minfo.display_primaries[2],       /* B */
+      minfo.display_primaries[0],       /* R */
+    };
+
+    raw[p++] = GST_H265_SEI_MASTERING_DISPLAY_COLOUR_VOLUME;    /* 137 */
+    raw[p++] = 24;              /* payloadSize */
+    for (i = 0; i < 3; i++) {
+      PUT16 (gbr[i].x);
+      PUT16 (gbr[i].y);
+    }
+    PUT16 (minfo.white_point.x);
+    PUT16 (minfo.white_point.y);
+    PUT32 (minfo.max_display_mastering_luminance);
+    PUT32 (minfo.min_display_mastering_luminance);
+
+    GST_DEBUG_OBJECT (self, "mastering-display SEI G(%u,%u)B(%u,%u)R(%u,%u) "
+        "WP(%u,%u) L(%u,%u)", gbr[0].x, gbr[0].y, gbr[1].x, gbr[1].y,
+        gbr[2].x, gbr[2].y, minfo.white_point.x, minfo.white_point.y,
+        minfo.max_display_mastering_luminance,
+        minfo.min_display_mastering_luminance);
+  }
+
+  if (have_cll) {
+    raw[p++] = GST_H265_SEI_CONTENT_LIGHT_LEVEL;        /* 144 */
+    raw[p++] = 4;               /* payloadSize */
+    PUT16 (cll.max_content_light_level);
+    PUT16 (cll.max_frame_average_light_level);
+
+    GST_DEBUG_OBJECT (self, "content-light SEI maxCLL=%u maxFALL=%u",
+        cll.max_content_light_level, cll.max_frame_average_light_level);
+  }
+
+  raw[p++] = 0x80;              /* rbsp_trailing_bits (one stop bit + align) */
+
+#undef PUT16
+#undef PUT32
+
+  res = gst_h265_bit_writer_convert_to_nal (4, FALSE, TRUE, FALSE, raw,
+      (gsize) p * 8, data, size);
+  if (res != GST_H265_BIT_WRITER_OK) {
+    GST_ERROR_OBJECT (self, "Failed to generate the HDR SEI bytes");
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+static gboolean
+_write_headers (GstVulkanH265Encoder * self,
+    GstVulkanH265EncoderFrame * vk_frame)
+{
+  GstMapInfo info;
+  guint aligned_offset, offset, orig_size, size, fillers;
+  GstH265BitWriterResult res;
+  guint8 aud_pic_type, *data;
+  GstVulkanVideoCapabilities vk_caps;
+  gboolean aud, ret = FALSE;
+  StdVideoH265PictureType pic_type = vk_frame->h265pic_info.pic_type;
+  GstBuffer *buffer = vk_frame->picture.out_buffer;
+
+  if (!gst_buffer_map (buffer, &info, GST_MAP_WRITE)) {
+    GST_ERROR_OBJECT (self, "Failed to map output buffer");
+    return FALSE;
+  }
+
+  offset = 0;
+  data = info.data;
+  orig_size = size = info.size;
+
+  GST_OBJECT_LOCK (self);
+  aud = self->prop.aud;
+  GST_OBJECT_UNLOCK (self);
+
+  if (aud) {
+    guint8 nal_buf[4096] = { 0, };
+    guint nal_size = sizeof (nal_buf);
+
+    switch (pic_type) {
+      case STD_VIDEO_H265_PICTURE_TYPE_IDR:
+      case STD_VIDEO_H265_PICTURE_TYPE_I:
+        aud_pic_type = 0;
+        break;
+      case STD_VIDEO_H265_PICTURE_TYPE_P:
+        aud_pic_type = 1;
+        break;
+      case STD_VIDEO_H265_PICTURE_TYPE_B:
+        aud_pic_type = 2;
+        break;
+      default:
+        g_assert_not_reached ();
+        break;
+    }
+
+    res = gst_h265_bit_writer_aud (aud_pic_type, TRUE, nal_buf, &nal_size);
+    if (res != GST_H265_BIT_WRITER_OK) {
+      GST_ERROR_OBJECT (self, "Failed to generate the AUD header");
+      goto bail;
+    }
+
+    res = gst_h265_bit_writer_convert_to_nal (4, FALSE, TRUE, FALSE, nal_buf,
+        nal_size * 8, data, &size);
+    if (res != GST_H265_BIT_WRITER_OK) {
+      GST_ERROR_OBJECT (self, "Failed to generate the AUD bytes");
+      goto bail;
+    }
+
+    offset += size + 1;
+  }
+
+  if (pic_type == STD_VIDEO_H265_PICTURE_TYPE_IDR) {
+    guint8 nal_buf[4096] = { 0, };
+    guint nal_size = sizeof (nal_buf);
+
+    res = gst_h265_bit_writer_vps (&self->vps, TRUE, nal_buf, &nal_size);
+    if (res != GST_H265_BIT_WRITER_OK) {
+      GST_ERROR_OBJECT (self, "Failed to generate the video header");
+      goto bail;
+    }
+
+    data = info.data + offset;
+    size = orig_size - offset;
+
+    res = gst_h265_bit_writer_convert_to_nal (4, FALSE, TRUE, FALSE, nal_buf,
+        nal_size * 8, data, &size);
+    if (res != GST_H265_BIT_WRITER_OK) {
+      GST_ERROR_OBJECT (self, "Failed to generate the VPS bytes");
+      goto bail;
+    }
+
+    offset += size + 1;
+
+    nal_size = sizeof (nal_buf);
+    memset (nal_buf, 0, sizeof (nal_buf));
+
+    res = gst_h265_bit_writer_sps (&self->sps, TRUE, nal_buf, &nal_size);
+    if (res != GST_H265_BIT_WRITER_OK) {
+      GST_ERROR_OBJECT (self, "Failed to generate the sequence header");
+      goto bail;
+    }
+
+    data = info.data + offset;
+    size = orig_size - offset;
+
+    res = gst_h265_bit_writer_convert_to_nal (4, FALSE, TRUE, FALSE, nal_buf,
+        nal_size * 8, data, &size);
+    if (res != GST_H265_BIT_WRITER_OK) {
+      GST_ERROR_OBJECT (self, "Failed to generate the SPS bytes");
+      goto bail;
+    }
+
+    offset += size + 1;
+  }
+
+  if (pic_type == STD_VIDEO_H265_PICTURE_TYPE_I
+      || pic_type == STD_VIDEO_H265_PICTURE_TYPE_IDR) {
+    guint8 nal_buf[4096] = { 0, };
+    guint nal_size = sizeof (nal_buf);
+
+    res = gst_h265_bit_writer_pps (&self->pps, TRUE, nal_buf, &nal_size);
+    if (res != GST_H265_BIT_WRITER_OK) {
+      GST_ERROR_OBJECT (self, "Failed to generate the picture header");
+      goto bail;
+    }
+
+    data = info.data + offset;
+    size = orig_size - offset;
+
+    res = gst_h265_bit_writer_convert_to_nal (4, FALSE, TRUE, FALSE, nal_buf,
+        nal_size * 8, data, &size);
+    if (res != GST_H265_BIT_WRITER_OK) {
+      GST_ERROR_OBJECT (self, "Failed to generate the PPS bytes");
+      goto bail;
+    }
+
+    offset += size + 1;
+  }
+
+  /* HDR10 static-metadata prefix SEI, alongside the parameter sets on each IDR.
+   * Only emitted when the input caps actually carry the HDR metadata. */
+  if (pic_type == STD_VIDEO_H265_PICTURE_TYPE_IDR) {
+    data = info.data + offset;
+    size = orig_size - offset;
+
+    if (!_write_hdr_sei (self, data, &size))
+      goto bail;
+
+    if (size > 0)
+      offset += size + 1;
+  }
+
+  gst_vulkan_encoder_caps (self->encoder, &vk_caps);
+  aligned_offset = GST_ROUND_UP_N (offset,
+      vk_caps.caps.minBitstreamBufferOffsetAlignment);
+
+  fillers = aligned_offset - offset;
+  if (fillers > 0) {
+    guint i;
+
+    /* The H.265 bit writer has no filler helper; emit a filler_data NAL
+     * (FD_NUT == 38) by hand. The NAL overhead is 7 bytes: 4-byte start code +
+     * 2-byte NAL header + 1-byte rbsp_trailing (0x80). */
+    while (fillers < 7 /* filler NAL overhead */ )
+      fillers += vk_caps.caps.minBitstreamBufferOffsetAlignment;
+
+    data = info.data + offset;
+    /* start code */
+    data[0] = 0x00;
+    data[1] = 0x00;
+    data[2] = 0x00;
+    data[3] = 0x01;
+    /* NAL header: forbidden_zero(0) | nal_unit_type(38) | layer_id(0) |
+     * temporal_id_plus1(1) => 0x4C 0x01 */
+    data[4] = 0x4C;
+    data[5] = 0x01;
+    for (i = 0; i < fillers - 7; i++)
+      data[6 + i] = 0xFF;         /* filler_data_byte */
+    data[6 + (fillers - 7)] = 0x80;     /* rbsp_trailing_bits */
+
+    offset += fillers;
+  }
+
+  vk_frame->picture.offset = offset;
+
+  ret = TRUE;
+
+bail:
+  gst_buffer_unmap (buffer, &info);
+  return ret;
+}
+
+static void
+_setup_rc_pic (GstVulkanEncoderPicture * pic,
+    VkVideoEncodeRateControlInfoKHR * rc_info,
+    VkVideoEncodeRateControlLayerInfoKHR * rc_layer, gpointer data)
+{
+  GstVulkanH265Encoder *self = data;
+  GstVulkanH265EncoderFrame *vk_frame = (GstVulkanH265EncoderFrame *) pic;
+  GstH265Encoder *h264enc = GST_H265_ENCODER (self);
+  guint32 idr_period, num_bframes;
+  gboolean b_pyramid;
+  VkVideoEncodeH265RateControlFlagsKHR rc_flag;
+
+  idr_period = gst_h265_encoder_get_idr_period (h264enc);
+  num_bframes = gst_h265_encoder_get_num_b_frames (h264enc);
+  b_pyramid = gst_h265_encoder_gop_is_b_pyramid (h264enc);
+
+  rc_flag = b_pyramid ?
+      VK_VIDEO_ENCODE_H265_RATE_CONTROL_REFERENCE_PATTERN_DYADIC_BIT_KHR
+      : VK_VIDEO_ENCODE_H265_RATE_CONTROL_REFERENCE_PATTERN_FLAT_BIT_KHR;
+
+  /* *INDENT-OFF* */
+  vk_frame->vkrc_info = (VkVideoEncodeH265RateControlInfoKHR) {
+    .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_RATE_CONTROL_INFO_KHR,
+    .flags = rc_flag | VK_VIDEO_ENCODE_H265_RATE_CONTROL_REGULAR_GOP_BIT_KHR,
+    .pNext = NULL,
+    .gopFrameCount = idr_period,
+    .idrPeriod = idr_period,
+    .consecutiveBFrameCount = num_bframes,
+    .subLayerCount = 0,
+  };
+  /* *INDENT-ON* */
+
+  rc_info->pNext = &vk_frame->vkrc_info;
+
+  if (rc_info->rateControlMode >
+      VK_VIDEO_ENCODE_RATE_CONTROL_MODE_DISABLED_BIT_KHR) {
+    rc_layer->averageBitrate = self->rc.bitrate * 1024;
+    rc_layer->maxBitrate = self->rc.max_bitrate * 1024;
+
+    /* virtualBufferSizeInMs ~ hrd_buffer_size * 1000LL / bitrate
+     *
+     * FIXME: add max-bitrate and coded-buffer-size properties to customize the
+     * bucket model
+     *
+     * for more information: https://www.youtube.com/watch?v=Mn8v1ojV80M */
+    rc_info->virtualBufferSizeInMs = self->rc.cpb_size;
+    rc_info->initialVirtualBufferSizeInMs = self->rc.cpb_size * (3 / 4);
+
+    /* *INDENT-OFF* */
+    vk_frame->vkrc_layer_info = (VkVideoEncodeH265RateControlLayerInfoKHR) {
+      .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_RATE_CONTROL_LAYER_INFO_KHR,
+
+      .useMinQp  = self->rc.min_qp > 0,
+      .minQp.qpI = self->rc.min_qp,
+      .minQp.qpP = self->rc.min_qp,
+      .minQp.qpB = self->rc.min_qp,
+
+      .useMaxQp  = self->rc.max_qp > 0,
+      .maxQp.qpI = self->rc.max_qp,
+      .maxQp.qpP = self->rc.max_qp,
+      .maxQp.qpB = self->rc.max_qp,
+
+      .useMaxFrameSize = 0,
+    };
+    /* *INDENT-ON* */
+
+    rc_layer->pNext = &vk_frame->vkrc_layer_info;
+    vk_frame->vkrc_info.subLayerCount = 1;
+  }
+}
+
+static void
+_setup_codec_pic (GstVulkanEncoderPicture * pic, VkVideoEncodeInfoKHR * info,
+    gpointer data)
+{
+  GstVulkanH265EncoderFrame *vk_frame = (GstVulkanH265EncoderFrame *) pic;
+
+  info->pNext = &vk_frame->vkh265pic_info;
+  pic->dpb_slot.pNext = &vk_frame->vkref_info;
+
+  /* *INDENT-OFF* */
+  vk_frame->vkh265pic_info = (VkVideoEncodeH265PictureInfoKHR) {
+    .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_PICTURE_INFO_KHR,
+    .pNext = NULL,
+    .naluSliceSegmentEntryCount = 1,
+    /* filled in _setup_slice() */
+    .pNaluSliceSegmentEntries = &vk_frame->vkslice_info,
+    .pStdPictureInfo = &vk_frame->h265pic_info,   /* filled in encode_frame() */
+  };
+  vk_frame->vkref_info = (VkVideoEncodeH265DpbSlotInfoKHR) {
+    .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_DPB_SLOT_INFO_KHR,
+    .pNext = NULL,
+    .pStdReferenceInfo = &vk_frame->ref_info, /* filled in encode_frame() */
+  };
+  /* *INDENT-ON* */
+}
+
+static guint8
+_get_slot_index (GArray * list, int i)
+{
+  GstH265EncoderFrame *h264_frame;
+
+  h264_frame = g_array_index (list, GstH265EncoderFrame *, i);
+  return _GET_FRAME (h264_frame)->picture.dpb_slot.slotIndex;
+}
+
+static void
+_setup_ref_lists (GstH265EncoderFrame * h265_frame, GstH265SliceHdr * slice_hdr,
+    GArray * list0, GArray * list1)
+{
+  int i;
+  GstVulkanH265EncoderFrame *vk_frame = _GET_FRAME (h265_frame);
+
+  /* *INDENT-OFF* */
+  vk_frame->ref_list_info = (StdVideoEncodeH265ReferenceListsInfo) {
+    .flags = {
+      .ref_pic_list_modification_flag_l0 = 0,
+      .ref_pic_list_modification_flag_l1 = 0,
+      .reserved = 0,
+    },
+    .num_ref_idx_l0_active_minus1 =
+        MIN (slice_hdr->num_ref_idx_l0_active_minus1,
+        STD_VIDEO_H265_MAX_NUM_LIST_REF),
+    .num_ref_idx_l1_active_minus1 =
+        MIN (slice_hdr->num_ref_idx_l1_active_minus1,
+        STD_VIDEO_H265_MAX_NUM_LIST_REF),
+    .RefPicList0 = { 0, }, /* filled below */
+    .RefPicList1 = { 0, }, /* filled below */
+    .list_entry_l0 = { 0, },
+    .list_entry_l1 = { 0, },
+  };
+  /* *INDENT-ON* */
+
+  for (i = 0; i < STD_VIDEO_H265_MAX_NUM_LIST_REF; i++) {
+    if (i < list0->len) {
+      vk_frame->ref_list_info.RefPicList0[i] = _get_slot_index (list0, i);
+    } else {
+      vk_frame->ref_list_info.RefPicList0[i] =
+          STD_VIDEO_H265_NO_REFERENCE_PICTURE;
+    }
+
+    if (i < list1->len) {
+      vk_frame->ref_list_info.RefPicList1[i] = _get_slot_index (list1, i);
+    } else {
+      vk_frame->ref_list_info.RefPicList1[i] =
+          STD_VIDEO_H265_NO_REFERENCE_PICTURE;
+    }
+  }
+}
+
+static void
+_setup_slice (GstVulkanH265Encoder * self, GstH265EncoderFrame * h265_frame,
+    GstH265SliceHdr * slice_hdr)
+{
+  GstVulkanH265EncoderFrame *vk_frame = _GET_FRAME (h265_frame);
+  GstH265SliceType slice_type = h265_frame->type.slice_type;
+
+  /* *INDENT-OFF* */
+  vk_frame->slice_hdr = (StdVideoEncodeH265SliceSegmentHeader) {
+    .flags = (StdVideoEncodeH265SliceSegmentHeaderFlags) {
+      .first_slice_segment_in_pic_flag =
+          slice_hdr->first_slice_segment_in_pic_flag,
+      .dependent_slice_segment_flag = slice_hdr->dependent_slice_segment_flag,
+      /* Slice flags match the upstream MR #5739 encoder exactly. */
+      .slice_sao_luma_flag = 1,
+      .slice_sao_chroma_flag = 1,
+      .num_ref_idx_active_override_flag =
+          slice_hdr->num_ref_idx_active_override_flag,
+      .mvd_l1_zero_flag = 0,
+      .cabac_init_flag = slice_hdr->cabac_init_flag,
+      .cu_chroma_qp_offset_enabled_flag = 1,
+      .deblocking_filter_override_flag = 1,
+      .slice_deblocking_filter_disabled_flag = 0,
+      .collocated_from_l0_flag = 0,
+      .slice_loop_filter_across_slices_enabled_flag = 0,
+    },
+    .slice_type = gst_vulkan_h265_slice_type(h265_frame->type.slice_type),
+    .slice_segment_address = 0,
+    .collocated_ref_idx = 0,
+    .MaxNumMergeCand = 5 - slice_hdr->five_minus_max_num_merge_cand,
+    .slice_cb_qp_offset = 0,
+    .slice_cr_qp_offset = 0,
+    .slice_beta_offset_div2 = 0,
+    .slice_tc_offset_div2 = 0,
+    .slice_act_y_qp_offset = 0,
+    .slice_act_cb_qp_offset = 0,
+    .slice_act_cr_qp_offset = 0,
+    .slice_qp_delta = 0,
+    .pWeightTable = NULL,
+  };
+
+  vk_frame->vkslice_info = (VkVideoEncodeH265NaluSliceSegmentInfoKHR) {
+    .sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_NALU_SLICE_SEGMENT_INFO_KHR,
+    .pNext = NULL,
+    /* Constant QP for cqp (rate-control disabled); the driver overrides it
+     * when an actual rate-control mode is active (upstream MR #5739). */
+    .constantQp = (self->rc.ratecontrol ==
+        VK_VIDEO_ENCODE_RATE_CONTROL_MODE_DISABLED_BIT_KHR) ? 26 : 0,
+    .pStdSliceSegmentHeader = &vk_frame->slice_hdr,
+  };
+  /* *INDENT-ON* */
+
+  /* slice_qp_delta stays 0: SliceQpY == init_qp (26). Computing it from the
+   * (rate-control-zeroed) constantQp would drop SliceQpY to 0 and make the
+   * driver's per-CU qp deltas underflow the conformant range (upstream
+   * MR #5739 hardcodes 0). */
+}
+
+static void
+_reset_rc_props (GstVulkanH265Encoder * self)
+{
+  GstVulkanVideoCapabilities vk_caps;
+  gint32 rc_mode;
+
+  if (!self->encoder)
+    return;
+
+  if (!gst_vulkan_encoder_caps (self->encoder, &vk_caps))
+    return;
+
+  GST_OBJECT_LOCK (self);
+  self->rc.ratecontrol = self->prop.ratecontrol;
+  self->rc.min_qp = (self->prop.min_qp > 0) ?
+      MAX (self->prop.min_qp, vk_caps.encoder.codec.h265.minQp) : 0;
+  self->rc.max_qp = (self->prop.max_qp > 0) ?
+      MIN (self->prop.max_qp, vk_caps.encoder.codec.h265.maxQp) : 0;
+  GST_OBJECT_UNLOCK (self);
+
+  if (self->rc.ratecontrol ==
+      VK_VIDEO_ENCODE_RATE_CONTROL_MODE_DISABLED_BIT_KHR) {
+    GST_OBJECT_LOCK (self);
+    self->rc.qp_i =
+        CLAMP (self->prop.qp_i, vk_caps.encoder.codec.h265.minQp,
+        vk_caps.encoder.codec.h265.maxQp);
+    self->rc.qp_p =
+        CLAMP (self->prop.qp_p, vk_caps.encoder.codec.h265.minQp,
+        vk_caps.encoder.codec.h265.maxQp);
+    self->rc.qp_b =
+        CLAMP (self->prop.qp_b, vk_caps.encoder.codec.h265.minQp,
+        vk_caps.encoder.codec.h265.maxQp);
+    GST_OBJECT_UNLOCK (self);
+  } else {
+    self->rc.qp_i = 0;
+    self->rc.qp_p = 0;
+    self->rc.qp_b = 0;
+  }
+
+  gst_vulkan_encoder_set_rc_mode (self->encoder, self->rc.ratecontrol);
+  rc_mode = gst_vulkan_encoder_rc_mode (self->encoder);
+  if (rc_mode != -1) {
+    self->rc.ratecontrol = rc_mode;
+    update_property_uint (self, &self->prop.ratecontrol, self->rc.ratecontrol,
+        PROP_RATECONTROL);
+  }
+
+  update_property_uint (self, &self->prop.qp_i, self->rc.qp_i, PROP_QP_I);
+  update_property_uint (self, &self->prop.qp_p, self->rc.qp_p, PROP_QP_P);
+  update_property_uint (self, &self->prop.qp_b, self->rc.qp_b, PROP_QP_B);
+  update_property_uint (self, &self->prop.min_qp, self->rc.min_qp, PROP_MIN_QP);
+  update_property_uint (self, &self->prop.max_qp, self->rc.max_qp, PROP_MAX_QP);
+}
+
+static StdVideoH265PictureType
+_gst_slice_type_2_vk_pic_type (GstH265GOPFrame * frame)
+{
+  if ((frame->slice_type == GST_H265_I_SLICE) && frame->is_ref)
+    return STD_VIDEO_H265_PICTURE_TYPE_IDR;
+  switch (frame->slice_type) {
+    case GST_H265_B_SLICE:
+      return STD_VIDEO_H265_PICTURE_TYPE_B;
+    case GST_H265_P_SLICE:
+      return STD_VIDEO_H265_PICTURE_TYPE_P;
+    case GST_H265_I_SLICE:
+      return STD_VIDEO_H265_PICTURE_TYPE_I;
+    default:
+      GST_WARNING ("Unsupported slice type '%d' for picture",
+          frame->slice_type);
+      return STD_VIDEO_H265_PICTURE_TYPE_INVALID;
+  }
+}
+
+static void
+update_properties_unlocked (GstVulkanH265Encoder * self)
+{
+  if (!self->update_props)
+    return;
+
+  GST_OBJECT_UNLOCK (self);
+  _reset_rc_props (self);
+  GST_OBJECT_LOCK (self);
+
+  self->update_props = FALSE;
+}
+
+static GstFlowReturn
+gst_vulkan_h265_encoder_encode_frame (GstH265Encoder * base,
+    GstVideoCodecFrame * frame, GstH265EncoderFrame * h264_frame,
+    GstH265SliceHdr * slice_hdr, GArray * list0, GArray * list1)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (base);
+  GstVulkanEncoderPicture *ref_pics[16] = { NULL, };
+  gint i, j;
+  GstVulkanH265EncoderFrame *vk_frame = _GET_FRAME (h264_frame);
+  StdVideoH265PictureType pic_type =
+      _gst_slice_type_2_vk_pic_type (&h264_frame->type);
+  gboolean is_irap = (h264_frame->type.slice_type == GST_H265_I_SLICE);
+  gint16 delta_poc_s0_minus1 = 0, delta_poc_s1_minus1 = 0;
+
+  if (!gst_vulkan_encoder_is_started (self->encoder))
+    return GST_FLOW_NOT_NEGOTIATED;
+
+  GST_OBJECT_LOCK (self);
+  update_properties_unlocked (self);
+  GST_OBJECT_UNLOCK (self);
+
+  if (list0->len > 0) {
+    GstH265EncoderFrame *ref = g_array_index (list0, GstH265EncoderFrame *, 0);
+    delta_poc_s0_minus1 = h264_frame->poc - ref->poc - 1;
+  }
+  if (list1->len > 0) {
+    GstH265EncoderFrame *ref = g_array_index (list1, GstH265EncoderFrame *, 0);
+    delta_poc_s1_minus1 = ref->poc - h264_frame->poc - 1;
+  }
+
+  /* *INDENT-OFF* */
+  vk_frame->short_term_ref_pic_set = (StdVideoH265ShortTermRefPicSet) {
+    .flags = (StdVideoH265ShortTermRefPicSetFlags) {
+      .inter_ref_pic_set_prediction_flag = 0u,
+      .delta_rps_sign = 0u,
+    },
+    .delta_idx_minus1 = 0,
+    .use_delta_flag = 0,
+    .abs_delta_rps_minus1 = 0,
+    .used_by_curr_pic_flag = 0,
+    .used_by_curr_pic_s0_flag = list0->len ? 1 : 0,
+    .used_by_curr_pic_s1_flag = list1->len ? 1 : 0,
+    .num_negative_pics = list0->len,
+    .num_positive_pics = list1->len,
+    .delta_poc_s0_minus1 = { delta_poc_s0_minus1 },
+    .delta_poc_s1_minus1 = { delta_poc_s1_minus1 },
+  };
+
+  vk_frame->h265pic_info = (StdVideoEncodeH265PictureInfo) {
+    .flags = {
+      .is_reference = h264_frame->type.is_ref,
+      .IrapPicFlag = is_irap,
+      .used_for_long_term_reference = 0,
+      .discardable_flag = 0,
+      .cross_layer_bla_flag = 0,
+      .pic_output_flag = slice_hdr->pic_output_flag,
+      .no_output_of_prior_pics_flag = slice_hdr->no_output_of_prior_pics_flag,
+      .short_term_ref_pic_set_sps_flag =
+          slice_hdr->short_term_ref_pic_set_sps_flag,
+      .slice_temporal_mvp_enabled_flag = 0,
+    },
+    .pic_type = pic_type,
+    .sps_video_parameter_set_id = self->params.vps.vps_video_parameter_set_id,
+    .pps_seq_parameter_set_id = self->params.sps.sps_seq_parameter_set_id,
+    .pps_pic_parameter_set_id = self->params.pps.pps_pic_parameter_set_id,
+    .short_term_ref_pic_set_idx = slice_hdr->short_term_ref_pic_set_idx,
+    .PicOrderCntVal = h264_frame->poc,
+    .TemporalId = 0,
+    .pRefLists = &vk_frame->ref_list_info, /* filled in setup_refs() */
+    .pShortTermRefPicSet = &vk_frame->short_term_ref_pic_set,
+    .pLongTermRefPics = NULL,
+  };
+
+  vk_frame->ref_info = (StdVideoEncodeH265ReferenceInfo) {
+    .flags = {
+      .used_for_long_term_reference = 0,
+      .unused_for_reference = 0,
+    },
+    .pic_type = pic_type,
+    .PicOrderCntVal = h264_frame->poc,
+    .TemporalId = 0,
+  };
+  /* *INDENT-ON* */
+
+  _setup_ref_lists (h264_frame, slice_hdr, list0, list1);
+  _setup_slice (self, h264_frame, slice_hdr);
+
+  vk_frame->picture.codec_rc_info = &vk_frame->vkrc_info;
+
+  g_assert (list0->len + list1->len <= 16);
+  for (i = 0; i < list0->len; i++) {
+    GstH265EncoderFrame *pic = g_array_index (list0, GstH265EncoderFrame *, i);
+    ref_pics[i] = &_GET_FRAME (pic)->picture;
+  }
+  for (j = 0; j < list1->len; j++) {
+    GstH265EncoderFrame *pic = g_array_index (list1, GstH265EncoderFrame *, j);
+    ref_pics[i++] = &_GET_FRAME (pic)->picture;
+  }
+
+  if (!_write_headers (self, vk_frame))
+    return GST_FLOW_ERROR;
+
+  if (!gst_vulkan_encoder_encode (self->encoder, &self->in_state->info,
+          &vk_frame->picture, i, ref_pics)) {
+    GST_ERROR_OBJECT (self, "Encode frame error");
+    return GST_FLOW_ERROR;
+  }
+  return GST_FLOW_OK;
+}
+
+static GstFlowReturn
+gst_vulkan_h265_encoder_prepare_output (GstH265Encoder * base,
+    GstVideoCodecFrame * frame)
+{
+  GstH265EncoderFrame *h264_frame;
+  GstVulkanH265EncoderFrame *vk_frame;
+
+  h264_frame = gst_video_codec_frame_get_user_data (frame);
+  vk_frame = _GET_FRAME (h264_frame);
+
+  gst_buffer_replace (&frame->output_buffer, vk_frame->picture.out_buffer);
+
+  return GST_FLOW_OK;
+}
+
+static void
+gst_vulkan_h265_encoder_reset (GstH265Encoder * base)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (base);
+
+  GST_OBJECT_LOCK (self);
+  self->rc.bitrate = self->prop.bitrate;
+  self->rc.quality = self->prop.quality;
+  GST_OBJECT_UNLOCK (self);
+
+  _reset_rc_props (self);
+
+  self->coded_buffer_size = 0;
+}
+
+static gboolean
+gst_vulkan_h265_encoder_open (GstVideoEncoder * base)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (base);
+  GstVulkanH265EncoderClass *klass = GST_VULKAN_H265_ENCODER_GET_CLASS (self);
+  GstVulkanEncoderCallbacks callbacks = { _setup_codec_pic, _setup_rc_pic };
+
+  if (!gst_vulkan_ensure_element_data (GST_ELEMENT (self), NULL,
+          &self->instance)) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NOT_FOUND,
+        ("Failed to retrieve vulkan instance"), (NULL));
+    return FALSE;
+  }
+
+  if (!gst_vulkan_ensure_element_device (GST_ELEMENT (self), self->instance,
+          &self->device, klass->device_index)) {
+    return FALSE;
+  }
+
+  self->encode_queue = gst_vulkan_device_select_queue (self->device,
+      VK_QUEUE_VIDEO_ENCODE_BIT_KHR);
+  if (!self->encode_queue) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NOT_FOUND,
+        ("Failed to create/retrieve vulkan H.265 encoder queue"), (NULL));
+    gst_clear_object (&self->instance);
+    return FALSE;
+  }
+
+  self->encoder =
+      gst_vulkan_encoder_create_from_queue (self->encode_queue,
+      VK_VIDEO_CODEC_OPERATION_ENCODE_H265_BIT_KHR);
+
+  if (!self->encoder) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NOT_FOUND,
+        ("Failed to retrieve vulkan encoder"), (NULL));
+    return FALSE;
+  }
+
+  gst_vulkan_encoder_set_callbacks (self->encoder, &callbacks, self, NULL);
+
+  return TRUE;
+}
+
+static gboolean
+gst_vulkan_h265_encoder_close (GstVideoEncoder * encoder)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (encoder);
+
+  gst_clear_object (&self->encoder);
+  gst_clear_object (&self->encode_queue);
+  gst_clear_object (&self->device);
+  gst_clear_object (&self->instance);
+
+  return TRUE;
+}
+
+static gboolean
+gst_vulkan_h265_encoder_stop (GstVideoEncoder * encoder)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (encoder);
+
+  if (self->in_state)
+    gst_video_codec_state_unref (self->in_state);
+  self->in_state = NULL;
+
+  gst_vulkan_encoder_stop (self->encoder);
+
+  return GST_VIDEO_ENCODER_CLASS (parent_class)->stop (encoder);
+}
+
+static gboolean
+_query_context (GstVulkanH265Encoder * self, GstQuery * query)
+{
+  if (!self->encoder)
+    return FALSE;
+  if (gst_vulkan_handle_context_query (GST_ELEMENT (self), query, NULL,
+          self->instance, self->device))
+    return TRUE;
+
+  if (gst_vulkan_queue_handle_context_query (GST_ELEMENT (self), query,
+          self->encode_queue))
+    return TRUE;
+
+  return FALSE;
+}
+
+static gboolean
+gst_vulkan_h265_encoder_src_query (GstVideoEncoder * encoder, GstQuery * query)
+{
+  gboolean ret = FALSE;
+
+  switch (GST_QUERY_TYPE (query)) {
+    case GST_QUERY_CONTEXT:
+      ret = _query_context (GST_VULKAN_H265_ENCODER (encoder), query);
+      break;
+    default:
+      ret = GST_VIDEO_ENCODER_CLASS (parent_class)->src_query (encoder, query);
+      break;
+  }
+
+  return ret;
+}
+
+static gboolean
+gst_vulkan_h265_encoder_sink_query (GstVideoEncoder * encoder, GstQuery * query)
+{
+  gboolean ret = FALSE;
+
+  switch (GST_QUERY_TYPE (query)) {
+    case GST_QUERY_CONTEXT:
+      ret = _query_context (GST_VULKAN_H265_ENCODER (encoder), query);
+      break;
+    default:
+      ret = GST_VIDEO_ENCODER_CLASS (parent_class)->sink_query (encoder, query);
+      break;
+  }
+
+  return ret;
+}
+
+static gboolean
+gst_vulkan_h265_encoder_propose_allocation (GstVideoEncoder * venc,
+    GstQuery * query)
+{
+  gboolean need_pool;
+  GstCaps *caps, *profile_caps;
+  GstVideoInfo info;
+  guint size;
+  GstBufferPool *pool = NULL;
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (venc);
+
+  if (!self->encoder) {
+    GST_ELEMENT_ERROR (self, RESOURCE, NOT_FOUND,
+        ("The vulkan encoder has not been initialized properly"), (NULL));
+    return FALSE;
+  }
+
+  gst_query_parse_allocation (query, &caps, &need_pool);
+
+  if (caps == NULL)
+    return FALSE;
+
+  if (!gst_video_info_from_caps (&info, caps))
+    return FALSE;
+
+  /* the normal size of a frame */
+  size = info.size;
+
+  if (!need_pool) {
+    gint height, width;
+
+    width = GST_VIDEO_INFO_WIDTH (&info);
+    height = GST_VIDEO_INFO_HEIGHT (&info);
+    need_pool = self->coded_width != width || self->coded_height != height;
+  }
+
+  if (need_pool) {
+    GstCaps *new_caps;
+    GstStructure *config;
+    GstVulkanVideoCapabilities vk_caps;
+
+    new_caps = gst_caps_copy (caps);
+    gst_caps_set_simple (new_caps, "width", G_TYPE_INT, self->coded_width,
+        "height", G_TYPE_INT, self->coded_height, NULL);
+
+    pool = gst_vulkan_image_buffer_pool_new (self->device);
+    config = gst_buffer_pool_get_config (pool);
+    gst_buffer_pool_config_set_params (config, new_caps, size, 0, 0);
+    gst_caps_unref (new_caps);
+
+    profile_caps = gst_vulkan_encoder_profile_caps (self->encoder);
+    gst_vulkan_image_buffer_pool_config_set_encode_caps (config, profile_caps);
+    gst_caps_unref (profile_caps);
+
+    gst_vulkan_image_buffer_pool_config_set_allocation_params (config,
+        VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+        VK_IMAGE_USAGE_VIDEO_ENCODE_SRC_BIT_KHR,
+        VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+        VK_IMAGE_LAYOUT_VIDEO_ENCODE_SRC_KHR,
+        VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+
+    if (!gst_vulkan_encoder_caps (self->encoder, &vk_caps)) {
+      gst_structure_free (config);
+      g_object_unref (pool);
+      return FALSE;
+    }
+    if ((vk_caps.caps.
+            flags & VK_VIDEO_CAPABILITY_SEPARATE_REFERENCE_IMAGES_BIT_KHR)
+        == 0) {
+      gst_structure_set (config, "num-layers", G_TYPE_UINT,
+          vk_caps.caps.maxDpbSlots, NULL);
+    }
+
+    if (!gst_buffer_pool_set_config (pool, config)) {
+      GST_WARNING_OBJECT (self, "Failed to set pool config");
+      g_object_unref (pool);
+      return FALSE;
+    }
+  }
+
+  gst_query_add_allocation_pool (query, pool, size,
+      self->sps.max_dec_pic_buffering_minus1[self->sps.max_sub_layers_minus1] + 1,
+      0);
+  if (pool)
+    gst_object_unref (pool);
+
+  return TRUE;
+}
+
+static gboolean
+gst_vulkan_h265_encoder_set_format (GstVideoEncoder * encoder,
+    GstVideoCodecState * state)
+{
+  gboolean ret;
+
+  ret = GST_VIDEO_ENCODER_CLASS (parent_class)->set_format (encoder, state);
+  if (ret)
+    ret = gst_h265_encoder_reconfigure (GST_H265_ENCODER (encoder), TRUE);
+  return ret;
+}
+
+static void
+gst_vulkan_h265_encoder_init (GTypeInstance * instance, gpointer g_class)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (instance);
+
+  gst_vulkan_buffer_memory_init_once ();
+
+  self->prop.aud = TRUE;
+  self->prop.qp_i = 26;
+  self->prop.qp_p = 26;
+  self->prop.qp_b = 26;
+  self->prop.max_qp = 0;
+  self->prop.min_qp = 0;
+  self->prop.ratecontrol = VK_VIDEO_ENCODE_RATE_CONTROL_MODE_DISABLED_BIT_KHR;
+  self->prop.quality = 2;
+}
+
+static void
+gst_vulkan_h265_encoder_get_property (GObject * object, guint property_id,
+    GValue * value, GParamSpec * pspec)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (object);
+
+  GST_OBJECT_LOCK (self);
+  switch (property_id) {
+    case PROP_BITRATE:
+      g_value_set_uint (value, self->prop.bitrate);
+      break;
+    case PROP_AUD:
+      g_value_set_boolean (value, self->prop.aud);
+      break;
+    case PROP_QUALITY:
+      g_value_set_uint (value, self->prop.quality);
+      break;
+    case PROP_RATECONTROL:
+      g_value_set_enum (value, self->prop.ratecontrol);
+      break;
+    case PROP_QP_I:
+      g_value_set_uint (value, self->prop.qp_i);
+      break;
+    case PROP_QP_B:
+      g_value_set_uint (value, self->prop.qp_b);
+      break;
+    case PROP_QP_P:
+      g_value_set_uint (value, self->prop.qp_p);
+      break;
+    case PROP_MAX_QP:
+      g_value_set_uint (value, self->prop.max_qp);
+      break;
+    case PROP_MIN_QP:
+      g_value_set_uint (value, self->prop.min_qp);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+  }
+  GST_OBJECT_UNLOCK (self);
+}
+
+static void
+gst_vulkan_h265_encoder_set_property (GObject * object, guint property_id,
+    const GValue * value, GParamSpec * pspec)
+{
+  GstVulkanH265Encoder *self = GST_VULKAN_H265_ENCODER (object);
+  GstH265Encoder *h264enc = GST_H265_ENCODER (object);
+  gboolean reconfigure = FALSE;
+
+  GST_OBJECT_LOCK (self);
+  switch (property_id) {
+    case PROP_BITRATE:
+      self->prop.bitrate = g_value_get_uint (value);
+      reconfigure = TRUE;
+      break;
+    case PROP_AUD:
+      self->prop.aud = g_value_get_boolean (value);
+      break;
+    case PROP_QUALITY:
+      self->prop.quality = g_value_get_uint (value);
+      reconfigure = TRUE;
+      break;
+    case PROP_RATECONTROL:
+      self->prop.ratecontrol = g_value_get_enum (value);
+      reconfigure = TRUE;
+      break;
+    case PROP_QP_I:
+      self->prop.qp_i = g_value_get_uint (value);
+      self->update_props = TRUE;
+      break;
+    case PROP_QP_P:
+      self->prop.qp_p = g_value_get_uint (value);
+      self->update_props = TRUE;
+      break;
+    case PROP_QP_B:
+      self->prop.qp_b = g_value_get_uint (value);
+      self->update_props = TRUE;
+      break;
+    case PROP_MAX_QP:
+      self->prop.max_qp = g_value_get_uint (value);
+      self->update_props = TRUE;
+      break;
+    case PROP_MIN_QP:
+      self->prop.min_qp = g_value_get_uint (value);
+      self->update_props = TRUE;
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+  }
+  GST_OBJECT_UNLOCK (self);
+
+  if (reconfigure)
+    gst_h265_encoder_reconfigure (h264enc, FALSE);
+}
+
+static void
+gst_vulkan_h265_encoder_class_init (gpointer g_klass, gpointer class_data)
+{
+  GstVulkanH265EncoderClass *klass = g_klass;
+  GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
+  GstVideoEncoderClass *encoder_class = GST_VIDEO_ENCODER_CLASS (klass);
+  GstH265EncoderClass *h264encoder_class = GST_H265_ENCODER_CLASS (klass);
+  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
+  struct CData *cdata = class_data;
+  GParamFlags param_flags =
+      G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS | G_PARAM_CONSTRUCT
+      | GST_PARAM_MUTABLE_PLAYING;
+  gchar *long_name;
+  const gchar *name;
+  GstPadTemplate *sink_pad_template, *src_pad_template;
+  GstCaps *sink_doc_caps, *src_doc_caps;
+
+  name = "Vulkan H.265 encoder";
+  if (cdata->description)
+    long_name = g_strdup_printf ("%s on %s", name, cdata->description);
+  else
+    long_name = g_strdup (name);
+
+  klass->device_index = cdata->device_index;
+
+  gst_element_class_set_metadata (element_class, long_name,
+      "Codec/Encoder/Video/Hardware", "A H.265 video encoder based on Vulkan",
+      "Stéphane Cerveau <scerveau@igalia.com>, "
+      "Victor Jaquez <vjaquez@igalia.com>");
+
+  parent_class = g_type_class_peek_parent (klass);
+
+  src_doc_caps = gst_caps_from_string ("video/x-h265, "
+      "profile = { (string) high, (string) main, (string) constrained-baseline }, "
+      "stream-format = (string) byte-stream, alignment = (string) au");
+  sink_doc_caps = gst_caps_from_string (GST_VIDEO_CAPS_MAKE_WITH_FEATURES
+      (GST_CAPS_FEATURE_MEMORY_VULKAN_IMAGE, "NV12"));
+
+  sink_pad_template =
+      gst_pad_template_new ("sink", GST_PAD_SINK, GST_PAD_ALWAYS, cdata->raw);
+  gst_element_class_add_pad_template (element_class, sink_pad_template);
+
+  src_pad_template =
+      gst_pad_template_new ("src", GST_PAD_SRC, GST_PAD_ALWAYS, cdata->codec);
+  gst_element_class_add_pad_template (element_class, src_pad_template);
+
+  gst_pad_template_set_documentation_caps (sink_pad_template, sink_doc_caps);
+  gst_caps_unref (sink_doc_caps);
+
+  gst_pad_template_set_documentation_caps (src_pad_template, src_doc_caps);
+  gst_caps_unref (src_doc_caps);
+
+  gobject_class->set_property =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_set_property);
+  gobject_class->get_property =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_get_property);
+
+  encoder_class->open = GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_open);
+  encoder_class->close = GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_close);
+  encoder_class->stop = GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_stop);
+  encoder_class->src_query =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_src_query);
+  encoder_class->sink_query =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_sink_query);
+  encoder_class->propose_allocation =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_propose_allocation);
+  encoder_class->set_format =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_set_format);
+
+  h264encoder_class->new_sequence =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_new_sequence);
+  h264encoder_class->new_parameters =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_new_parameters);
+  h264encoder_class->new_output =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_new_output);
+  h264encoder_class->encode_frame =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_encode_frame);
+  h264encoder_class->prepare_output =
+      GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_prepare_output);
+  h264encoder_class->reset = GST_DEBUG_FUNCPTR (gst_vulkan_h265_encoder_reset);
+
+  /**
+   * GstVulkanH265Encoder:bitrate:
+   *
+   * Bitrate is the amount of data (in kilobits) to process per second. It's
+   * both a function of the encoded bitstream data size of the encoded pictures
+   * as well as the frame rate used by the video sequence
+   *
+   * A higher bitrate will result in a better visual quality but it will result
+   * in a bigger file. A lower bitrate will result in a smaller file, but it
+   * will also result in  a worse visual quality.
+   *
+   * Since: 1.28
+   */
+  properties[PROP_BITRATE] = g_param_spec_uint ("bitrate", "Bitrate (kbps)",
+      "The desired bitrate expressed in kbps (0: auto-calculate)",
+      0, G_MAXUINT, 0, param_flags);
+
+  /**
+   * GstVulkanH265Encoder:aud:
+   *
+   * Insert the AU (Access Unit) delimeter for each frame.
+   *
+   * Since: 1.28
+   */
+  properties[PROP_AUD] = g_param_spec_boolean ("aud", "Insert AUD",
+      "Insert AU (Access Unit) delimeter for each frame", TRUE, param_flags);
+
+  /**
+   * GstVulkanH265Encoder:qp-i:
+   *
+   * Indicates the quantization parameter for all the slices in each I frame.
+   * It's only applied when the rate control mode
+   * (#GstVulkanH265Encoder:rc-mode) is CQP (constant quantization parameter).
+   *
+   * Lower QP values mean higher video quality, but larger file sizes or higher
+   * bitrates.
+   *
+   * Since: 1.28
+   */
+  properties[PROP_QP_I] = g_param_spec_uint ("qp-i", "Constant I frame QP",
+      "Constant quantization value for each I-frame slice", 0, 51, 26,
+      param_flags);
+
+  /**
+   * GstVulkanH265Encoder:qp-p:
+   *
+   * Indicates the quantization parameter for all the slices in each P frame.
+   * It's only applied when the rate control mode
+   * (#GstVulkanH265Encoder:rc-mode) is CQP (constant quantization parameter).
+   *
+   * Lower QP values mean higher video quality, but larger file sizes or higher
+   * bitrates.
+   *
+   * Since: 1.28
+   */
+  properties[PROP_QP_P] = g_param_spec_uint ("qp-p", "Constant P frame QP",
+      "Constant quantization value for each P-frame slice", 0, 51, 26,
+      param_flags);
+
+  /**
+   * GstVulkanH265Encoder:qp-b:
+   *
+   * Indicates the quantization parameter for all the slices in each B frame.
+   * It's only applied when the rate control mode
+   * (#GstVulkanH265Encoder:rc-mode) is CQP (constant quantization parameter).
+   *
+   * Lower QP values mean higher video quality, but larger file sizes or higher
+   * bitrates.
+   *
+   * Since: 1.28
+   */
+  properties[PROP_QP_B] = g_param_spec_uint ("qp-b", "Constant B frame QP",
+      "Constant quantization value for each B-frame slice", 0, 51, 26,
+      param_flags);
+
+  /**
+   * GstVulkanH265Encoder:max-qp:
+   *
+   * Indicates the quantization parameter upper bound for each frame. It's only
+   * applied when the rate control mode (#GstVulkanH265Encoder:rc-mode) is
+   * either CBR (constant bitrate) or VBR (variable bitrate).
+   *
+   * Lower QP values mean higher video quality, but larger file sizes or higher
+   * bitrates.
+   *
+   * If zero, the upper bound will not be clamped.
+   *
+   * Since: 1.28
+   */
+  properties[PROP_MAX_QP] = g_param_spec_uint ("max-qp", "Maximum QP",
+      "Maximum quantization value for each frame (0: disabled)", 0, 51, 0,
+      param_flags);
+
+  /**
+   * GstVulkanH265Encoder:min-qp:
+   *
+   * Indicates the quantization parameter lower bound for each frame. It's only
+   * applied when the rate control mode (#GstVulkanH265Encoder::rc-mode) is
+   * either CBR (constant bitrate) or VBR (variable bitrate).
+   *
+   * Lower QP values mean higher video quality, but larger file sizes or higher
+   * bitrates.
+   *
+   * If zero, the lower bound will not be clamped.
+   *
+   * Since: 1.28
+   */
+  properties[PROP_MIN_QP] = g_param_spec_uint ("min-qp", "Minimum QP",
+      "Minimum quantization value for each frame (0: disabled)", 0, 51, 0,
+      param_flags);
+
+  /**
+   * GstVulkanH265Encoder:rate-control:
+   *
+   * Rate control algorithms adjust encoding parameters dynamically to regulate
+   * the output bitrate. This can involve managing Quantization Parameters (QP),
+   * quality, or other encoding parameters.
+   *
+   * Since: 1.28
+   */
+  properties[PROP_RATECONTROL] = g_param_spec_enum ("rate-control",
+      "rate control mode", "The encoding rate control mode to use",
+      GST_TYPE_VULKAN_ENCODER_RATE_CONTROL_MODE,
+      VK_VIDEO_ENCODE_RATE_CONTROL_MODE_DISABLED_BIT_KHR, param_flags);
+
+  /**
+   * GstVulkanH265Encoder:quality:
+   *
+   * Video encode quality level.
+   *
+   * Higher quality levels may produce higher quality videos at the cost of
+   * additional processing time.
+   *
+   * Since: 1.28
+   */
+  properties[PROP_QUALITY] = g_param_spec_uint ("quality", "quality level",
+      "Video encoding quality level", 0, 10, 2, param_flags);
+
+  g_object_class_install_properties (gobject_class, N_PROPERTIES, properties);
+
+  /* since GstVulkanEncoder is private API */
+  gst_type_mark_as_plugin_api (GST_TYPE_VULKAN_ENCODER_RATE_CONTROL_MODE, 0);
+
+  g_free (long_name);
+  g_free (cdata->description);
+  gst_clear_caps (&cdata->codec);
+  gst_clear_caps (&cdata->raw);
+  g_free (cdata);
+}
+
+gboolean
+gst_vulkan_h265_encoder_register (GstPlugin * plugin, GstVulkanDevice * device,
+    guint rank)
+{
+  static GOnce debug_once = G_ONCE_INIT;
+  GType type;
+  GTypeInfo type_info = {
+    .class_size = sizeof (GstVulkanH265EncoderClass),
+    .class_init = gst_vulkan_h265_encoder_class_init,
+    .instance_size = sizeof (GstVulkanH265Encoder),
+    .instance_init = gst_vulkan_h265_encoder_init,
+  };
+  struct CData *cdata;
+  gboolean ret;
+  gchar *type_name, *feature_name;
+  GstCaps *codec = NULL, *raw = NULL;
+
+  g_return_val_if_fail (GST_IS_PLUGIN (plugin), FALSE);
+  g_return_val_if_fail (GST_IS_VULKAN_DEVICE (device), FALSE);
+
+  if (!gst_vulkan_physical_device_codec_caps (device->physical_device,
+          VK_VIDEO_CODEC_OPERATION_ENCODE_H265_BIT_KHR, &codec, &raw)) {
+    gst_plugin_add_status_warning (plugin,
+        "Unable to query H.265 encoder properties");
+    return FALSE;
+  }
+
+  cdata = g_new (struct CData, 1);
+  cdata->description = NULL;
+  cdata->device_index = device->physical_device->device_index;
+  cdata->codec = codec;
+  cdata->raw = raw;
+
+  /* class data will be leaked if the element never gets instantiated */
+  GST_MINI_OBJECT_FLAG_SET (cdata->codec, GST_MINI_OBJECT_FLAG_MAY_BE_LEAKED);
+  GST_MINI_OBJECT_FLAG_SET (cdata->raw, GST_MINI_OBJECT_FLAG_MAY_BE_LEAKED);
+
+  gst_vulkan_create_feature_name (device, "GstVulkanH265Encoder",
+      "GstVulkanH265Device%dEncoder", &type_name, "vulkanh265enc",
+      "vulkanh265device%denc", &feature_name, &cdata->description, &rank);
+
+  type_info.class_data = cdata;
+
+  g_once (&debug_once, _register_debug_category, NULL);
+  type = g_type_register_static (GST_TYPE_H265_ENCODER,
+      type_name, &type_info, 0);
+
+  ret = gst_element_register (plugin, feature_name, rank, type);
+
+  g_free (type_name);
+  g_free (feature_name);
+
+  return ret;
+}
